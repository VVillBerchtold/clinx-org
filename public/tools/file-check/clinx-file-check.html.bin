e}.stack thead th button{border:1px solid var(--line);border-radius:var(--pill);background:var(--surface);margin:0;padding:.3125rem .6875rem}.stack thead th[aria-sort=ascending] button,.stack thead th[aria-sort=descending] button{border-color:var(--accent);background:var(--accent-wash)}.stack tbody tr,.stack tfoot tr{border-top:1px solid var(--line);grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:.625rem 1rem;padding:1rem .875rem;display:grid}.stack tbody tr:first-child{border-top:0}.stack tfoot tr{background:var(--surface-2);border-top-width:2px}.stack tfoot tr+tr{border-top-width:1px}.table-wrap.wide.stack tbody th[scope=row],.table-wrap.wide.stack tfoot th[scope=row],.table-wrap.stack tbody td,.table-wrap.stack tfoot td{width:auto;min-width:0;max-width:none;box-shadow:none;text-align:left;white-space:normal;background:0 0;border:0;padding:0;display:block;position:static}.table-wrap.wide.stack tbody th[scope=row],.table-wrap.wide.stack tfoot th[scope=row],.stack td.share,.stack td.wide-cell,.stack tfoot td:last-child:nth-child(2){grid-column:1/-1}.stack tbody th[scope=row]{font-size:1.0625rem;line-height:1.3}.stack td:empty,.stack td.blank{display:none}.stack td[data-label]:before{content:attr(data-label);color:var(--muted);font-size:var(--text-xs);margin-bottom:.125rem;font-weight:600;display:block}.stack td.num{white-space:nowrap}.stack td.share .rail{gap:.75rem;margin-top:.125rem}.stack tbody tr:hover{background:0 0}.table-wrap:not(.wide):not(.drug-wrap) table,.table-wrap.printed table{font-size:var(--text-sm)}.table-wrap:not(.wide):not(.drug-wrap) :is(tbody th,td:not(.num)),.table-wrap.printed :is(tbody th,td:not(.num)){hyphens:auto}.lines table,.lines caption,.lines tbody{display:block}.lines thead{clip-path:inset(50%);width:1px;height:1px;margin:-1px;position:absolute;overflow:hidden}.lines tbody tr{border-top:1px solid var(--line);grid-template-columns:1.75rem minmax(0,1fr);gap:.375rem .5rem;padding:.875rem;display:grid}.lines tbody tr:first-child{border-top:0}.table-wrap.lines tbody th,.table-wrap.lines tbody td{text-align:left;hyphens:manual;border:0;padding:0;display:block}.lines tbody th{color:var(--muted)}.lines tbody td{grid-column:2}.lines td[data-label]:before{content:attr(data-label);color:var(--muted);font-size:var(--text-xs);margin-bottom:.125rem;font-weight:600;display:block}}@media (prefers-reduced-motion:reduce){*,:before,:after{transition:none!important;animation:none!important}}@media print{.site-nav,.skip-link,.onpage,.page-bar,.to-top,.foot-top,.pager{display:none}}.doc-part{margin:var(--s7,4rem) 0 0;padding-top:var(--s4,1.5rem);border-top:1px solid var(--line);font-size:var(--text-xs);letter-spacing:.08em;text-transform:uppercase;color:var(--accent);font-weight:700}.doc-part:first-child{border-top:0;margin-top:0;padding-top:0}.doc-part+h2{margin-top:var(--s2,.75rem)}
</style></head><body id="top"><a class="skip-link" href="#main">Skip to the content</a><header class="site-header"><div class="wrap"><a class="mark" href="https://clinx.org/" aria-label="ClinX home"><svg class="wordmark" viewBox="41.83 -760 2426.33 774" aria-hidden="true" focusable="false"><path transform="translate(0 0) scale(1 -1)" d="M373.5 -14Q294.5 -14 232.83 8Q171.17 30 128.58 73.42Q86 116.83 63.92 179.58Q41.83 242.33 41.83 323.83Q41.83 407.33 64.42 472Q87 536.67 129.5 582.08Q172 627.5 231 650.75Q290 674 363.83 674Q422.5 674 470.75 658.92Q519 643.83 553.42 615.42Q587.83 587 606.5 547.25Q625.17 507.5 625 458.33L476 421.17Q476.33 461.67 459.67 488.5Q443 515.33 416.25 529.42Q389.5 543.5 358 543.5Q331.67 543.5 305.33 532.58Q279 521.67 257.75 496.92Q236.5 472.17 223.75 432.42Q211 392.67 211 334.17Q211 258.17 232.42 210.08Q253.83 162 291.83 138.83Q329.83 115.67 377.33 115.67Q428.33 115.67 456.5 137.92Q484.67 160.17 496.5 194.67Q508.33 229.17 508.5 266L650.67 244.67Q650.67 190.5 636.08 143.33Q621.5 96.17 589 60.75Q556.5 25.33 503.25 5.67Q450 -14 373.5 -14Z"></path><path transform="translate(657 0) scale(1 -1)" d="M58.5 0V716.67H217.17V0Z"></path><path transform="translate(913 0) scale(1 -1)" d="M58.5 0V528H219.67V0Z"></path><path transform="translate(1171 0) scale(1 -1)" d="M58.5 0V314.83V528H188.83L190.5 363.83H209.33Q221.17 423.5 244.5 463.17Q267.83 502.83 304.83 522.42Q341.83 542 393 542Q484.83 542 532.5 478.33Q580.17 414.67 580.17 276.67V0H418.17V258.17Q418.17 336.33 395.83 372.08Q373.5 407.83 329.17 407.83Q292.5 407.83 268.25 385.17Q244 362.5 231.83 323Q219.67 283.5 219.67 232V0Z"></path><path transform="translate(1777 0) scale(1 -1)" d="M13.5 0 238.17 330.33 19.33 660H208L348.17 415.5H353.5L494.83 660H685.16L464 334L691.16 0H501.5L353.67 252.17H348.33L202.17 0Z"></path><path class="wordmark-dot" transform="translate(913 0) scale(1 -1)" d="M139.33 596.83Q93.33 596.83 68.83 616.19Q44.33 635.55 44.33 672.28Q44.33 710 68.83 729.5Q93.33 749 139.33 749Q186.33 749 210.83 729.42Q235.33 709.83 235.33 672.41Q235.33 636 210.83 616.42Q186.33 596.83 139.33 596.83Z"></path></svg></a><nav class="site-nav" aria-label="Main"><ul><li><details class="nav-drop"><summary>340B<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false"><path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></summary><ul class="nav-panel"><li><a href="https://clinx.org/scorecard/"><strong>Scorecard</strong><span>The 340B figures each state publishes</span></a></li><li><a href="https://clinx.org/laws/"><strong>State laws</strong><span>The 340B laws each state has passed</span></a></li><li><a href="https://clinx.org/bills/"><strong>Bills</strong><span>The 340B bills in Congress and the states</span></a></li><li><a href="https://clinx.org/notices/"><strong>Federal notices</strong><span>Federal rules and notices that name 340B</span></a></li><li><a href="https://clinx.org/calendar/"><strong>Calendar</strong><span>Bill steps, hearings and federal deadlines</span></a></li><li><a href="https://clinx.org/rebate-pilot/"><strong>Rebate pilot</strong><span>What the federal rebate pilot changes</span></a></li></ul></details></li><li><details class="nav-drop"><summary>Health centers<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false"><path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></summary><ul class="nav-panel"><li><a href="https://clinx.org/health-centers/records/"><strong>Records</strong><span>What each health center reported to HRSA</span></a></li><li><a href="https://clinx.org/health-centers/funding/"><strong>Funding</strong><span>HRSA opportunities and Federal Register dates</span></a></li><li><a href="https://clinx.org/health-centers/shortage-areas/"><strong>Shortage areas</strong><span>What HRSA designates, proposes to withdraw and changes</span></a></li></ul></details></li><li><a href="https://clinx.org/data/">Data</a></li><li><a href="https://clinx.org/methods/">Methods</a></li><li><a href="https://clinx.org/tools/" aria-current="page">Tools</a></li><li><a href="https://clinx.org/writing/">Writing</a></li><li><a href="https://clinx.org/about/">About</a></li><li><a href="https://clinx.org/contact/">Contact</a></li></ul></nav><details class="nav-menu"><summary><svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false"><path class="bar-a" d="M3 6h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path><path class="bar-b" d="M3 12h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg><span>Menu</span></summary><nav aria-label="Main"><ul><li><details class="nav-fold"><summary>340B<svg width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false"><path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></summary><ul><li><a href="https://clinx.org/scorecard/">Scorecard</a></li><li><a href="https://clinx.org/laws/">State laws</a></li><li><a href="https://clinx.org/bills/">Bills</a></li><li><a href="https://clinx.org/notices/">Federal notices</a></li><li><a href="https://clinx.org/calendar/">Calendar</a></li><li><a href="https://clinx.org/rebate-pilot/">Rebate pilot</a></li></ul></details></li><li><details class="nav-fold"><summary>Health centers<svg width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false"><path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg></summary><ul><li><a href="https://clinx.org/health-centers/records/">Records</a></li><li><a href="https://clinx.org/health-centers/funding/">Funding</a></li><li><a href="https://clinx.org/health-centers/shortage-areas/">Shortage areas</a></li></ul></details></li><li><a href="https://clinx.org/data/">Data</a></li><li><a href="https://clinx.org/methods/">Methods</a></li><li><a href="https://clinx.org/tools/" aria-current="page">Tools</a></li><li><a href="https://clinx.org/writing/">Writing</a></li><li><a href="https://clinx.org/about/">About</a></li><li><a href="https://clinx.org/contact/">Contact</a></li></ul></nav></details></div></header><main id="main" tabindex="-1"><div class="wrap page"><svg class="cc-sprite" width="0" height="0" aria-hidden="true" focusable="false"><symbol id="cc-i-check" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m4 10.5 4 4 8-9"></path></symbol><symbol id="cc-i-right" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h12M11 5l5 5-5 5"></path></symbol><symbol id="cc-i-left" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 10H4M9 5l-5 5 5 5"></path></symbol><symbol id="cc-i-save" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3v10M5.5 9l4.5 4.5L14.5 9M4 16.5h12"></path></symbol><symbol id="cc-i-file" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2.5h5.5l4 4V16a1.5 1.5 0 0 1-1.5 1.5H6A1.5 1.5 0 0 1 4.5 16V4A1.5 1.5 0 0 1 6 2.5ZM11.5 2.5v4h4M7.5 10.5h5M7.5 13.5h5"></path></symbol><symbol id="cc-i-columns" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 4h13v12h-13zM8 4v12M12.5 4v12"></path></symbol><symbol id="cc-i-search" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3.5a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11ZM13.2 13.2 17 17"></path></symbol><symbol id="cc-i-info" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2.5a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15ZM10 9.2V14M10 6.3v.2"></path></symbol><symbol id="cc-i-copy" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h9.5v9.5H7zM4 13V3.5h9.5"></path></symbol></svg><header class="page-head wide"><nav class="kicker" aria-label="You are here"><span class="dot" aria-hidden="true"></span><a href="https://clinx.org/tools/">Tools</a><span class="sep" aria-hidden="true">/</span><span>File Check</span></nav><h1>File Check</h1><p class="lede">Give it a report. Get a list of what will trip up a script or a pivot table, with the cells each thing is in and what to do about it.</p><ul class="cc-promises"><li><svg width="16" height="16" aria-hidden="true" focusable="false"><use href="#cc-i-check"></use></svg>Runs in your browser</li><li><svg width="16" height="16" aria-hidden="true" focusable="false"><use href="#cc-i-check"></use></svg>Opens no connection</li><li><svg width="16" height="16" aria-hidden="true" focusable="false"><use href="#cc-i-check"></use></svg>Changes nothing in the file</li></ul></header><p class="panel fc-saved"><strong>Saved copy.</strong> File Check, version 1.0, made 17 November 2026 and kept by ClinX. This one file holds the whole tool and opens no connection. Its fingerprint is printed at <a href="https://clinx.org/tools/file-check/">clinx.org/tools/file-check/</a>, with the way to compare it.</p><p id="cc-off" class="panel cc-off">This tool works in your browser, so it needs scripts turned on.</p><div id="cc" class="cc fc" hidden><div class="cc-rail"><ol id="cc-steps" class="cc-steps has-three"><li><button type="button" class="cc-stepper" data-go="1" disabled><span class="cc-num" aria-hidden="true"><span>1</span><svg width="16" height="16" focusable="false"><use href="#cc-i-check"></use></svg></span><span class="cc-step-say"><span class="cc-step-count">Step 1</span><span class="cc-step-name">Choose a file</span></span></button></li><li><button type="button" class="cc-stepper" data-go="2" disabled><span class="cc-num" aria-hidden="true"><span>2</span><svg width="16" height="16" focusable="false"><use href="#cc-i-check"></use></svg></span><span class="cc-step-say"><span class="cc-step-count">Step 2</span><span class="cc-step-name">Go through the list</span></span></button></li><li><button type="button" class="cc-stepper" data-go="3" disabled><span class="cc-num" aria-hidden="true"><span>3</span><svg width="16" height="16" focusable="false"><use href="#cc-i-check"></use></svg></span><span class="cc-step-say"><span class="cc-step-count">Step 3</span><span class="cc-step-name">Take the list</span></span></button></li></ol><div class="fc-lines"><p class="cc-wire" id="cc-wire"><span class="cc-wire-dot" aria-hidden="true"></span><span id="cc-wire-say">No connection can be opened from this page</span></p><p class="cc-wire" id="fc-selftest"><span class="cc-wire-dot" aria-hidden="true"></span><span id="fc-selftest-say">Testing itself on the built-in sample</span></p></div></div><p id="cc-where" class="cc-where" aria-hidden="true"></p><div class="cc-body"><!-- Step 1 --><section id="cc-step-1" class="cc-step" aria-labelledby="cc-h-1"><header class="cc-step-head"><h2 id="cc-h-1" tabindex="-1">Choose a file</h2><p>An Excel workbook (.xlsx or .xlsm) or a CSV file. The page reads it inside your browser and changes nothing in it.</p></header><div id="cc-drop" class="cc-drop"><span class="cc-badge big"><svg width="30" height="30" aria-hidden="true" focusable="false"><use href="#cc-i-file"></use></svg></span><p class="cc-drop-say">Drop a workbook or a CSV file here</p><div class="btn-row"><input id="cc-file" class="visually-hidden" type="file" accept=".xlsx,.xlsm,.csv,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" aria-describedby="cc-drop-help"><label for="cc-file" class="btn accent">Choose a file</label><button id="cc-sample" class="btn ghost" type="button">Try the sample report</button></div><p id="cc-drop-help" class="small muted">The sample report is a small workbook of invented visits with the usual kinds of mess in it. It is a good first run.</p></div><p id="cc-problem" class="cc-problem" role="alert" hidden></p><div id="cc-loaded" class="cc-loaded" hidden><div class="cc-filecard"><span class="cc-badge"><svg width="22" height="22" aria-hidden="true" focusable="false"><use href="#cc-i-file"></use></svg></span><div class="cc-filecard-say"><strong id="cc-file-name"></strong><span id="cc-file-meta" class="small muted"></span></div><button id="cc-other" class="cc-link" type="button">Choose another file</button></div><div id="fc-verdict"></div><dl id="cc-file-stats" class="cc-stats"></dl></div></section><!-- Step 2 --><section id="cc-step-2" class="cc-step" aria-labelledby="cc-h-2" hidden><header class="cc-step-head"><h2 id="cc-h-2" tabindex="-1">Go through the list</h2><p>What needs fixing comes first. Each thing names its cells and says what to do about it.</p></header><div id="fc-chooser" class="cc-chooser"><nav id="fc-sheets" class="cc-sheets" aria-label="Sheets in this file"><h3>Sheets</h3><ul id="cc-sheet-list"></ul></nav><div class="cc-sheet fc-sheet" id="cc-sheet"></div></div></section><!-- Step 3 --><section id="cc-step-3" class="cc-step" aria-labelledby="cc-h-3" hidden><header class="cc-step-head"><h2 id="cc-h-3" tabindex="-1">Take the list</h2><p id="fc-take-say">The same list as plain text, to keep or to hand to whoever will fix the file.</p></header><div id="fc-take" class="cc-result"></div></section></div><div class="cc-foot"><button id="cc-back" class="btn ghost" type="button"><svg width="18" height="18" aria-hidden="true" focusable="false"><use href="#cc-i-left"></use></svg>Back</button><p id="cc-tally" class="cc-tally" aria-live="polite"></p><button id="cc-next" class="btn accent" type="button" disabled><span id="cc-next-say">Go through the list</span><svg width="18" height="18" aria-hidden="true" focusable="false"><use href="#cc-i-right"></use></svg></button></div><p id="cc-live" class="visually-hidden" role="status" aria-live="polite"></p></div><section class="cc-about" aria-labelledby="cc-about-h"><h2 id="cc-about-h">When to run the check</h2><ul class="cc-uses"><li><h3>Before a pivot table</h3><p>A pivot table needs one row of headings, a heading on each column, and no empty rows. The list says where a sheet falls short of that.</p></li><li><h3>Before a script or a bot</h3><p>A script stops on the one cell that is text in a column of numbers. The list names that cell before the script meets it.</p></li><li><h3>Before asking for help</h3><p>The list holds no value from a cell, so it can go into a chat or a ticket to say what is wrong with a file.</p></li></ul><a class="cc-read" href="https://clinx.org/tools/cleaner-copy/"><span><span class="label">Tool</span><strong>Cleaner Copy</strong><span class="muted">When someone needs the shape of the whole report, make a copy with randomized values.</span></span><svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false"><path d="M3 9h12M10 4l5 5-5 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></section><script type="module">const __worker1="\"use strict\";\n(function(){let e=new TextDecoder,t=new TextEncoder;function n(t){let n=new DataView(t.buffer,t.byteOffset,t.byteLength);if(t.length<22)throw Error(`This is not a workbook: it is too short to be one.`);let r=t.length-22,i=Math.max(0,r-65535);for(;r>=i&&n.getUint32(r,!0)!==101010256;)r--;if(r<i)throw Error(`This is not a workbook, or the file was cut short.`);let a=n.getUint16(r+10,!0),o=n.getUint32(r+16,!0);if(a===65535||o===4294967295)throw Error(`This tool does not read files over 4 GB.`)