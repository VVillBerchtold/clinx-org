---
/**
 * A list of calendar events in the order given: the day on the left, what happened on the right.
 * A step of a bill shows its kind, the bill (a link to its card), the legislature's own words and
 * a link to the legislature's page. A session's first or last day shows the session's name. A date
 * of a federal rule or notice shows where it is printed (a link to its entry on the notices page),
 * its title and the agency, with a link to the Federal Register.
 */
import '../styles/notices.css';
import { getBills } from '../lib/bills';
import { calendarPath, calendarPlaceName, eventBillHref, eventNoticeHref, isNoticeDay, isSessionDay, kindLabel, weekdayOf, type CalendarEvent } from '../lib/calendar';
import { getNotices } from '../lib/notices';

interface Props {
  events: readonly CalendarEvent[];
  /** True on a page that mixes places: each row then says which place it is. */
  showPlace?: boolean;
}
const { events, showPlace = false } = Astro.props;
const titles = new Map(getBills().bills.map((b) => [b.billId, b.title]));
const notices = new Map(getNotices().notices.map((n) => [n.noticeId, n]));
---

<ul class="cal-rows">
  {
    events.map((event, i) => {
      const session = isSessionDay(event);
      const notice = isNoticeDay(event) ? notices.get(event.noticeId) : undefined;
      // A day a notice sets is named in a few words of ours; the document's title goes under it.
      const setDay = event.kind === 'date set by a notice';
      const more = [event.time, event.body, event.where].filter((part) => part !== '');
      return (
        <li class:list={['cal-row', session && 'session', notice && 'notice', i > 0 && events[i - 1]!.day === event.day && 'same']}>
          <time class="cal-day" datetime={event.day}>
            <span>{weekdayOf(event.day)}</span>
            <strong>{Number(event.day.slice(8))}</strong>
          </time>
          <div class="cal-body">
            <p class="cal-head">
              <span class="cal-kind">{kindLabel(event.kind)}</span>
              {showPlace && <a href={calendarPath(event.place)}>{calendarPlaceName(event.place)}</a>}
              {notice && <a href={eventNoticeHref(event)}>{notice.citation}</a>}
              {!session && !notice && event.bill !== '' && <a href={eventBillHref(event)}>{event.bill}</a>}
            </p>
            {!session && !notice && titles.get(event.billId) && <p class="cal-title">{titles.get(event.billId)}</p>}
            <p class="cal-what">{event.what}</p>
            {notice && setDay && <p class="cal-title">{notice.title}</p>}
            <p class="cal-more">
              {more.map((part) => (
                <span>{part}</span>
              ))}
              <a href={event.link}>{session ? 'The legislature’s site' : notice ? 'Federal Register' : 'Official page'}</a>
            </p>
          </div>
        </li>
      );
    })
  }
</ul>
