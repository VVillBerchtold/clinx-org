---
import '../styles/home.css';
import '../styles/scorecard.css';
import Base from '../layouts/Base.astro';
import Cited from './Cited.astro';
import DifferencesTable from './DifferencesTable.astro';
import OnPage from './OnPage.astro';
import PageHead from './PageHead.astro';
import { drugReportViewFor, formatDate, getDataset, pdfHref } from '../lib/data';
import { numberWord, numberWordCap } from '../lib/site';
import { STATE_REGISTRY, stateName } from '../lib/states';

/**
 * A state's page when the state prints statewide figures and lists of drugs (Maine): the summary's
 * four figures, each list of drugs, the hospitals the report names, and where the figures come from.
 * No row names a hospital, so there is no page per hospital and no measure. The words that depend on the
 * form come from forms.ts; the figures and the report's own sentences come from the dataset.
 */
interface Props {
  code: string;
}

const { code } = Astro.props;
const data = getDataset();
const report = drugReportViewFor(data, code);
const { spec, filing, summary, lists, hospitals, descriptions, differences } = report;
const name = stateName(code);
const entry = STATE_REGISTRY[code];
const year = filing.reportingYear;
const pdf = (page: number) => pdfHref(filing, page);
const pageLabel = (page: number) => `Page ${page} of the report PDF`;
const count = report.count;
// The date the report is dated, from its own title ("... Report, April 2, 2026").
const issued = /,\s*([A-Z][a-z]+ \d{1,2}, \d{4})$/.exec(filing.formRevision)?.[1];
if (!issued) throw new Error(`${code}: the report's title does not end with its date`);

// The summary's sentences, each once, in the order printed (two figures share one sentence).
const sentences = [...new Set(summary.map((s) => s.sentence))].map((text) => ({ text, page: summary.find((s) => s.sentence === text)!.row.page }));
const summaryPage = sentences[0]!.page;
const dollars = (text: string): string => `$${text}`;
const anchor = (schedule: string): string => schedule.replaceAll('_', '-');
const pagesText = (first: number, last: number): string => (first === last ? `page ${first}` : `pages ${first} to ${last}`);
const [costly, frequent] = lists;
if (!costly || !frequent) throw new Error(`${code}: the page expects two lists of drugs`);
---

<Base
  title={`${name} 340B report: fiscal year ${year}, totals and drug lists`}
  crumbs={[{ name: 'Scorecard', path: '/scorecard/' }, { name, path: `/scorecard/${code.toLowerCase()}/` }]}
  description={`What the ${spec.agency} printed in its 340B report for fiscal year ${year}: four totals for ${count} hospitals added together, two lists of drugs with their costs and savings, and the hospitals named. Every figure links to its page of the report.`}
>
  <PageHead title={name} trail={[{ label: 'Scorecard', href: '/scorecard/' }, { label: `Fiscal year ${year}, state report` }]}>
    <p class="lede">
      The {spec.agency} published its 340B report of {issued}, as Maine's law requires. It covers fiscal year {year} and adds together what {numberWord(count)} hospitals sent. It prints no figure for any single hospital, so no figure here belongs to one.
    </p>
    <OnPage
      title={name}
      items={[
        { id: 'headline', label: 'Four totals' },
        { id: anchor(costly.spec.schedule), label: 'Most costly drugs' },
        { id: anchor(frequent.spec.schedule), label: 'Most frequently dispensed drugs' },
        { id: 'hospitals', label: 'The hospitals' },
        ...(differences.length > 0 ? [{ id: 'differences', label: 'Differences' }] : []),
        { id: 'read-with-care', label: 'Read it with care' },
        { id: 'sources', label: 'Where the figures come from' },
      ]}
    />
  </PageHead>

  <div class="prose">
    <h2 id="headline">Four totals</h2>
    <p>
      The report's summary, headed "{report.summaryTitle.labelAsFiled}", gives these four figures for all {numberWord(count)} hospitals together. The two dollar totals are rounded in the report to a tenth of a million, and they are shown here as the report prints them.
    </p>
    <ul class="stats report-tiles">
      {
        summary.map((s) => (
          <li>
            <strong><Cited value={s.printed} href={pdf(s.row.page)} label={s.cite} /></strong>
            <span>{s.figure.caption}</span>
          </li>
        ))
      }
    </ul>
    <figure class="page-quote">
      <blockquote>
        {sentences.map((s) => <p>{s.text}</p>)}
      </blockquote>
      <figcaption>
        The {sentences.length === 1 ? 'sentence' : `${numberWord(sentences.length)} sentences`} the report prints these figures in, word for word.{' '}
        <Cited value="Open the page" href={pdf(summaryPage)} label={pageLabel(summaryPage)} />
      </figcaption>
    </figure>

    <p>
      Below the totals the report lists drugs, in two tables. Each hospital named its three most costly drugs and its three most frequently dispensed drugs. A drug is in a table when at least one hospital named it, and the figures beside it are the report's totals for that drug's NDC. The last column is the number of hospitals that named the drug.
    </p>

    {
      lists.map((list, i) => (
        <>
          <h2 id={anchor(list.spec.schedule)}>{i === 0 ? 'Most costly drugs' : 'Most frequently dispensed drugs'}</h2>
          <p>
            The report's title for this table is "{list.title.labelAsFiled}". It lists {numberWord(list.rows.length)} drugs on {pagesText(list.pages.first, list.pages.last)} of the report.{' '}
            {i === 1 && (
              <>
                {' '}The report says this table is limited to drugs the hospitals dispensed, and may leave out drugs they administered (<Cited value="page 7" href={pdf(list.share.page)} label={pageLabel(list.share.page)} />).
              </>
            )}
          </p>
          <figure class="page-quote">
            <blockquote>
              <p>{list.share.labelAsFiled}</p>
            </blockquote>
            <figcaption>
              The sentence the report prints above the table, word for word.{' '}
              <Cited value="Open the page" href={pdf(list.share.page)} label={pageLabel(list.share.page)} />
            </figcaption>
          </figure>
          <div class="table-wrap wide stack drug-list" id={`table-${anchor(list.spec.schedule)}`}>
            <table data-sortable role="table">
              <caption><span>{list.subtitle.labelAsFiled}: {numberWord(list.rows.length)} drugs as {spec.asWord}</span></caption>
              <thead role="rowgroup">
                <tr role="row">
                  <th role="columnheader" scope="col" data-sort="text">Drug and class as {spec.asWord}</th>
                  <th role="columnheader" scope="col" data-sort="text">NDC</th>
                  <th role="columnheader" scope="col" class="num" data-sort="number">Total acquisition cost</th>
                  <th role="columnheader" scope="col" class="num" data-sort="number">Total estimated savings</th>
                  <th role="columnheader" scope="col" class="num" data-sort="number">Hospitals that named it</th>
                </tr>
              </thead>
              <tbody role="rowgroup">
                {
                  list.rows.map((r) => (
                    <tr role="row" class="tone-plain">
                      <th role="rowheader" scope="row">
                        {r.drug}
                        <span class="sub">{r.drugClass}</span>
                      </th>
                      <td role="cell" class="mono ndc" data-label="NDC">{r.ndc}</td>
                      <td role="cell" class="num" data-label="Total acquisition cost" data-value={r.cost.amountCents ?? ''}>
                        <Cited value={dollars(r.cost.amountAsFiled)} href={pdf(r.page)} label={`Total acquisition cost of ${r.drug}, page ${r.page} of the report PDF`} />
                      </td>
                      <td role="cell" class="num" data-label="Total estimated savings" data-value={r.savings.amountCents ?? ''}>
                        <Cited value={dollars(r.savings.amountAsFiled)} href={pdf(r.page)} label={`Total estimated savings of ${r.drug}, page ${r.page} of the report PDF`} />
                      </td>
                      <td role="cell" class="num" data-label="Hospitals that named it" data-value={r.hospitalCount}>
                        <Cited value={r.hospitals.amountAsFiled} href={pdf(r.page)} label={`Hospitals that named ${r.drug}, page ${r.page} of the report PDF`} />
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="small muted">
            Drug names, classes and NDCs are the report's own words. Select a column heading to sort. <a href="#top">Back to top</a>
          </p>
        </>
      ))
    }

    <h2 id="hospitals">The hospitals</h2>
    <p>
      The report names the {numberWord(hospitals.length)} hospitals that sent data. On pages {descriptions.firstPage} to {descriptions.lastPage} each one describes, in its own words, the programs and services its 340B savings fund. ClinX lists the hospitals and links to those pages. It does not transcribe the descriptions, which also state figures about each hospital.
    </p>
    <ul class="name-list" aria-label={`The ${hospitals.length} hospitals the report names`}>
      {hospitals.map((h) => <li>{h}</li>)}
    </ul>
    <p>
      <a class="btn ghost" href={pdf(descriptions.firstPage)}>Read the descriptions, pages {descriptions.firstPage} to {descriptions.lastPage}</a>
    </p>
    <p class="small muted">The hospitals are in the order the report's pages print them.</p>

    {
      differences.length > 0 && (
        <DifferencesTable
          differences={differences}
          name={name}
          spec={spec}
          lead={`${numberWordCap(differences.length)} ${differences.length === 1 ? 'place' : 'places'} where two figures of the report differ. Nothing was changed; both figures are kept as ${spec.asWord}.`}
        />
      )
    }

    <section aria-labelledby="read-with-care">
      <div class="note">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="8.5" stroke="currentColor" stroke-width="2"></circle><path d="M10 9v5M10 6v.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
        <div>
          <p><strong id="read-with-care">Read it with care.</strong> These are totals the state published, and the two dollar totals are rounded as the report prints them. The report is the State's summary of what the hospitals sent. The hospitals' own filings are not in this dataset, so the totals cannot be checked against them.</p>
          <p>A drug appears in a table only when some hospital named it among its three. The tables are not a list of every drug the hospitals bought or dispensed. A drug that no hospital placed among its three is not listed.</p>
          <p>No measure is calculated for {name}. The other states' measures are worked out for each filer, and this report has one set of figures for the whole state. So {name}'s figures are shown as the state printed them, and the states are not added together or compared. <a href="/methods/#5-measures">Methods</a> sets out each calculation.</p>
        </div>
      </div>
    </section>

    <h2 id="sources">Where the figures come from</h2>
    {entry?.stands && <p>{entry.stands}</p>}
    {entry?.sources && <div class="btn-row">{entry.sources.map((src) => <a class="btn ghost" href={src.href}>{src.label}</a>)}</div>}
    <dl class="facts panel">
      <dt>Report PDF</dt>
      <dd><a href={pdfHref(filing, 1)}>Open the report on the {spec.publisher}</a></dd>
      <dt>Title</dt>
      <dd>{filing.formRevision}</dd>
      <dt>Period</dt>
      <dd>{filing.periodAsFiled}</dd>
      <dt>SHA-256</dt>
      <dd><span class="mono">{filing.pdfSha256}</span></dd>
      <dt>Retrieved</dt>
      <dd>{formatDate(filing.retrievedAt)}</dd>
      <dt>Pages used</dt>
      <dd>{report.pages.first} to {descriptions.lastPage} of {filing.pageCount}</dd>
    </dl>
  </div>
</Base>
