---
/**
 * The states of one kind of reporting, A to Z: what each state makes public today, a link to its
 * Scorecard page where ClinX holds its figures, and the official sources. The law and where it
 * stands are one tap away. Everything shown is typed once, in the registry (src/lib/states.ts).
 */
import Arrow from './Arrow.astro';
import { getLaws, lawsOf, lawsPath } from '../lib/laws';
import { STATE_REGISTRY, VISIBILITY_LABEL, statesInGroup, type ReportingGroup } from '../lib/states';

interface Props {
  group: ReportingGroup;
  /** For a state in the Scorecard, how much of it is there, in a few words ("14 rows"). */
  counts?: Readonly<Record<string, string>>;
}
const { group, counts = {} } = Astro.props;
const laws = getLaws();
const states = statesInGroup(group);
---

<ul class="standings">
  {
    states.map((s) => {
      const e = STATE_REGISTRY[s.code];
      if (!e?.visibility || !e.stands || !e.sources) throw new Error(`State ${s.code} is missing its details`);
      const mine = lawsOf(laws, s.code).length > 0;
      return (
        <li class={`standing v-${e.visibility}`} id={`state-${s.code.toLowerCase()}`}>
          <div class="standing-id">
            <span class="standing-code" aria-hidden="true">{s.code}</span>
            <div>
              <h3>{s.name}</h3>
              <span class="chip">{VISIBILITY_LABEL[e.visibility]}</span>
            </div>
          </div>
          <div class="standing-say">
            <p>{e.publicNow}</p>
            {e.status === 'live' && e.href && (
              <a class="btn standing-open" href={e.href}>
                Open the scorecard for {s.name}
                <Arrow />
              </a>
            )}
            {e.status === 'live' && counts[s.code] && <p class="standing-held">In the scorecard: {counts[s.code]} · {e.summary}</p>}
            <details class="standing-law">
              <summary>The law and where it stands</summary>
              <p>{e.stands}</p>
            </details>
          </div>
          <ul class="standing-src">
            {e.sources.map((src) => (
              <li>
                <a href={src.href}>
                  {src.label}
                  <span class="visually-hidden"> for {s.name}</span>
                </a>
              </li>
            ))}
            {mine && (
              <li>
                <a href={lawsPath(s.code)}>
                  All 340B laws
                  <span class="visually-hidden"> in {s.name}</span>
                </a>
              </li>
            )}
          </ul>
        </li>
      );
    })
  }
</ul>
