---
/**
 * The 340B registry's history, 2010 to today: contract pharmacy arrangements as today's registry
 * records them, month by month. One long page in seven parts: the count, the pharmacies, the
 * distance, the chains, who holds them, the state laws, and what this record cannot say.
 * Every chart is drawn at build time (src/lib/registry.ts); the hover layer is
 * src/scripts/registry-charts.ts. Each chart has a table with the same figures.
 */
import '../../styles/registry.css';
import Base from '../../layouts/Base.astro';
import events from '../../data/registry/events.json';
import {
  FULL_RECORD_FROM,
  H,
  REGISTRY_REPO,
  aroundLaw,
  at,
  flowRows,
  fmt,
  lastMonth,
  lawMap,
  lawStates,
  COHORTS,
  CONCENTRATION,
  INSURER,
  lawAligned,
  lawAlignedChart,
  lineChart,
  monthLong,
  monthShort,
  pct,
  inbound,
  medianShare,
  mapFacts,
  shareMap,
  timeLapse,
  SHARE_BANDS,
  smallMultiple,
  stateName,
  type FederalEvent,
  type Marker,
} from '../../lib/registry';

const last = lastMonth();
const N = H.national;
const first = '2010-01';
const arr = at(N.arrangements, last);
const ph = at(N.pharmacies, last);
const ent = at(N.entities, last);
const out = at(N.out_of_state, last);
const y16 = '2016-01';
const fed = events as FederalEvent[];
const markers: Marker[] = fed
  .filter((e) => e.label && e.date >= `${first}-01`)
  .map((e, i) => ({ month: e.date.slice(0, 7), label: e.label, level: i % 3 }));

// 1. The count, in layers by the year each arrangement began.
const cohortLayers = COHORTS.years.map((yr) => ({
  label: yr === COHORTS.years[0] ? `began ${yr} or before` : `began in ${yr}`,
  values: COHORTS.layers[String(yr)]!,
  labelled: yr >= 2022,
}));
const nowOf = (yr: number): number => COHORTS.layers[String(yr)]!.at(-1) ?? 0;
const recent = COHORTS.years.filter((yr) => yr >= 2024).reduce((a, yr) => a + nowOf(yr), 0);
const peakOf = (yr: number): number => Math.max(...COHORTS.layers[String(yr)]!);
const kept20 = nowOf(2020) / peakOf(2020);
const sumUpTo = (yr: number, m: string): number =>
  COHORTS.years.filter((y) => y <= yr).reduce((a, y) => a + (COHORTS.layers[String(y)]![H.months.indexOf(m)] ?? 0), 0);
const storySteps = [
  { upto: 0, year: '2010', text: `${fmt(at(N.arrangements, first))} arrangements are in force. Until March, most covered entities could use only one outside pharmacy.` },
  { upto: 6, year: '2010 to 2016', text: `From March 2010, an entity may use as many outside pharmacies as it likes. Each year's new arrangements stack on the chart as a new band. By January 2017, the bands for 2010 to 2016 hold ${fmt(sumUpTo(2016, '2017-01'))} arrangements.` },
  { upto: 10, year: '2017 to 2020', text: `The bands thicken. At its height the 2020 band alone holds ${fmt(peakOf(2020))} arrangements, more than the bands for 2010 to 2016 held together in January 2017.` },
  { upto: 13, year: '2021 to 2023', text: `From July 2020, drug makers limit the 340B price at contract pharmacies, and states begin to pass laws against the limits. New arrangements keep coming: the 2023 band reaches ${fmt(peakOf(2023))}.` },
  { upto: 16, year: 'Today', text: `${fmt(arr)} in force. ${pct(recent / arr)} began in 2024 or later, and every older band is thinning as its arrangements end.` },
];
const hero = lineChart({
  layers: cohortLayers,
  id: 'hero',
  frame: 'hero',
  area: true,
  shadeBefore: FULL_RECORD_FROM,
  markers,
  series: [{ key: 'arr', label: 'arrangements', values: N.arrangements, slot: 1 }],
  title: 'Contract pharmacy arrangements in the 340B registry, by month',
  desc: `From ${fmt(at(N.arrangements, first))} on ${monthLong(first)} to ${fmt(arr)} on ${monthLong(last)}, as the registry records them today.`,
});

// 2. The pharmacies.
const perPharmacy = N.arrangements.map((a, i) => (N.pharmacies[i] ? a / N.pharmacies[i]! : 0));
// Concentration: arrangements by how many the pharmacy holds.
const CC = CONCENTRATION;
const ccTotal = CC.months.map((_, i) => CC.bins.reduce((a, b) => a + (CC.arrangements[b]![i] ?? 0), 0));
const ccShare = (b: string): number[] => CC.arrangements[b]!.map((v, i) => (ccTotal[i] ? v / ccTotal[i]! : 0));
const ccOrder = [...CC.bins].reverse(); // the biggest pharmacies at the bottom
const ccCls: Record<string, string> = { '200 or more': 'ck16', '50 to 199': 'ck13', '10 to 49': 'ck10', '2 to 9': 'ck7', '1': 'ck4' };
const big = '200 or more';
const bigPh = CC.pharmacies[big]!.at(-1) ?? 0;
const bigArr = CC.arrangements[big]!.at(-1) ?? 0;
const phNow = ccTotal.length ? CC.bins.reduce((a, b) => a + (CC.pharmacies[b]!.at(-1) ?? 0), 0) : 0;
const conc = lineChart({
  id: 'conc',
  frame: 'full',
  from: '2012-01',
  percent: true,
  layers: ccOrder.map((b) => ({
    label: b === '1' ? 'pharmacies with 1 arrangement' : `pharmacies with ${b}`,
    values: ccShare(b),
    labelled: true,
    cls: ccCls[b] ?? 'ck8',
  })),
  series: [{ key: 'all', label: 'all arrangements', values: ccTotal.map(() => 1), slot: 1 }],
  title: 'Share of arrangements by how many arrangements the pharmacy holds, by month',
  desc: `On ${monthLong(last)}, ${fmt(bigPh)} pharmacies with 200 or more arrangements each hold ${pct(bigArr / arr)} of all ${fmt(arr)}.`,
});
const phPeak = Math.max(...N.pharmacies);
const phPeakMonth = H.months[N.pharmacies.indexOf(phPeak)]!;
const pharmacies = lineChart({
  id: 'pharm',
  markers: [{ month: phPeakMonth, label: `Peak, ${monthShort(phPeakMonth)}` }],
  frame: 'half',
  from: '2012-01',
  series: [{ key: 'ph', label: 'pharmacies', values: N.pharmacies, slot: 1 }],
  title: 'Distinct contract pharmacies, by month',
  desc: `${fmt(at(N.pharmacies, '2012-01'))} in January 2012, ${fmt(ph)} on ${monthLong(last)}.`,
});
const ratio = lineChart({
  id: 'ratio',
  frame: 'half',
  from: '2012-01',
  series: [{ key: 'pp', label: 'per pharmacy', values: perPharmacy.map((v) => Math.round(v * 10) / 10), slot: 2 }],
  title: 'Arrangements for each contract pharmacy, by month',
  desc: `${perPharmacy[H.months.indexOf('2012-01')]!.toFixed(1)} in January 2012, ${perPharmacy[perPharmacy.length - 1]!.toFixed(1)} on ${monthLong(last)}.`,
});

// 3. The distance.
const share = N.arrangements.map((a, i) => (a ? N.out_of_state[i]! / a : 0));
// The same share, split by who owns the pharmacy (tools/insurer.py).
const IN = INSURER;
const insOut = IN.insurer_out.map((v, i) => (IN.arrangements[i] ? v / IN.arrangements[i]! : 0));
const othOut = IN.out_of_state.map((v, i) => (IN.arrangements[i] ? (v - IN.insurer_out[i]!) / IN.arrangements[i]! : 0));
const ix = (m: string): number => IN.months.indexOf(m);
const insPartOf = (m: string): number => IN.insurer_out[ix(m)]! / Math.max(IN.out_of_state[ix(m)]!, 1);
const otherRate = (m: string): number => (IN.out_of_state[ix(m)]! - IN.insurer_out[ix(m)]!) / Math.max(IN.arrangements[ix(m)]! - IN.insurer[ix(m)]!, 1);
const insRate = (m: string): number => IN.insurer_out[ix(m)]! / Math.max(IN.insurer[ix(m)]!, 1);
const insNow = IN.insurer.at(-1) ?? 0;
const ownersLine = Object.entries(IN.owners).map(function (e) { return e[0] + ' ' + fmt(e[1]); }).join('; ');
const insDays: string[] = IN.months.filter(function (m) { return m.endsWith('-01') && m.localeCompare('2012-01') !== -1; }).concat(last.endsWith('-01') ? [] : [last]);
const insRows = insDays.map(function (m) {
  const k = ix(m);
  const out = fmt(IN.out_of_state[k]!) + ' (' + pct(IN.out_of_state[k]! / IN.arrangements[k]!, 1) + ')';
  return { day: monthLong(m), out, part: pct(insPartOf(m)), other: pct(otherRate(m), 1) };
});
const distance = lineChart({
  id: 'dist',
  frame: 'full',
  from: '2012-01',
  percent: true,
  line: true,
  layers: [
    { label: 'at insurer-owned pharmacies', values: insOut, labelled: true, cls: 'oi' },
    { label: 'at all other pharmacies', values: othOut, labelled: true, cls: 'oo' },
  ],
  shadeBefore: FULL_RECORD_FROM,
  series: [{ key: 'out', label: 'in another state', values: share, slot: 2 }],
  title: "Share of arrangements whose pharmacy is in another state from the entity's street address",
  desc: `${pct(share[H.months.indexOf('2012-01')]!, 1)} in January 2012, ${pct(share[share.length - 1]!)} on ${monthLong(last)}.`,
});
const y17 = '2017-01';
const mapThen = shareMap(y17);
const mapNow = shareMap(last);
const medThen = medianShare(y17);
const medNow = medianShare(last);
const pairs = flowRows(last, 12);
const receiving = inbound(y17, last, 10);
const inMax = Math.max(...receiving.map((r) => r.now), 1);
function bw(v: number): string {
  const w = v > 0 ? Math.max(1, Math.round((v / inMax) * 100)) : 0;
  return 'w' + w;
}
const fl = receiving[0]!;
const lapse = timeLapse(receiving);
// The map's scroll story: five Januaries, each told from its own numbers.
const f12 = mapFacts('2012-01');
const f17 = mapFacts('2017-01');
const f20 = mapFacts('2020-01');
const f23 = mapFacts('2023-01');
const lastJan = Object.keys(H.out_of_state).filter((m) => m.endsWith('-01') && m <= last).sort().pop()!;
const fJan = mapFacts(lastJan);
const fNow = mapFacts(last);
const nm = (r: { code: string }[], i: number): string => stateName(r[i]?.code ?? '');
const mapSteps: { month: string; year: string; label?: string; narrow?: boolean; text: string }[] = [
  { month: '2012-01', year: '2012',
    text: `Only ${f12.measured} states have 50 arrangements to measure. The typical one sends ${pct(f12.median, 1)} of them to a pharmacy across a state line.` },
  { month: '2017-01', year: '2017',
    text: `Every state is on the map. The typical one sends ${pct(f17.median)} out of state, and ${fmt(f17.crossing)} arrangements cross a line, the most of them to ${nm(f17.receivers, 0)}.` },
  { month: '2020-01', year: '2020',
    text: `The typical state now sends ${pct(f20.median)} out of state. ${nm(f20.receivers, 0)} draws the most from other states: ${fmt(f20.receivers[0]?.n ?? 0)} arrangements.` },
  { month: '2023-01', year: '2023',
    text: `${f23.half} states send half or more of their arrangements across a line. ${fmt(f23.crossing)} arrangements cross one in all.` },
  { month: lastJan, year: lastJan.slice(0, 4),
    text: `${fJan.half} states send half or more. ${nm(fJan.receivers, 0)}, ${nm(fJan.receivers, 1)} and ${nm(fJan.receivers, 2)} draw the most, and ${fmt(fJan.crossing)} arrangements cross a line. The map beside it is today.` },
  // On a narrow screen only one map is pinned, so Today gets a step of its own.
  { month: last, year: '', label: `Today, ${monthShort(last)}`, narrow: true,
    text: `${fNow.half} states send half or more, and ${fmt(fNow.crossing)} arrangements cross a line. ${nm(fNow.receivers, 0)} ${fNow.receivers[0]?.code === fJan.receivers[0]?.code ? 'still draws' : 'now draws'} the most.` },
];
const B = SHARE_BANDS;
const shareKey = [
  { cls: 'sh-b0', label: `Under ${pct(B[0] ?? 0)}` },
  ...B.slice(0, -1).map((t, i) => ({ cls: `sh-b${i + 1}`, label: `${pct(t)} to ${pct(B[i + 1] ?? 0)}` })),
  { cls: `sh-b${B.length}`, label: `${pct(B[B.length - 1] ?? 0)} and over` },
];

// 4. The chains.
const C = H.chains;
const chainSeries = C.groups.map((g, i) => ({ key: g, label: g, values: C.arrangements[g]!, slot: i === 4 ? 0 : i + 1 }));
const totals = N.arrangements;
const cvsOver = H.months.find((m) => at(C.arrangements.CVS!, m) > at(C.arrangements.Walgreens!, m) && m > '2015-01');
const chains = lineChart({
  id: 'chains',
  markers: cvsOver ? [{ month: cvsOver, label: 'CVS passes Walgreens' }] : [],
  frame: 'full',
  from: '2012-01',
  stacked: true,
  percent: true,
  series: chainSeries.map((s) => ({ ...s, values: s.values.map((v, i) => (totals[i] ? v / totals[i]! : 0)) })),
  title: 'Share of arrangements by pharmacy group, by month',
  desc: C.groups.map((g) => `${g} ${pct(at(C.arrangements[g]!, last) / arr)}`).join(', ') + ` on ${monthLong(last)}.`,
});
const mail = Object.entries(C.mail_detail).sort((a, b) => b[1].arrangements - a[1].arrangements);
const mailArr = at(C.arrangements['Mail-order and specialty']!, last);
const mailPh = at(C.pharmacies['Mail-order and specialty']!, last);

// 5. Who holds them.
const T = H.types;
const types = lineChart({
  id: 'types',
  frame: 'full',
  from: '2012-01',
  shadeBefore: FULL_RECORD_FROM,
  series: T.groups.map((g, i) => ({ key: g, label: g, values: T.arrangements[g]!, slot: i + 1 })),
  title: 'Contract pharmacy arrangements by kind of covered entity, by month',
  desc: T.groups.map((g) => `${g} ${fmt(at(T.arrangements[g]!, last))}`).join(', ') + ` on ${monthLong(last)}.`,
});

// 6. The laws.
const lawsIn = lawStates();
const aligned = lawAligned();
const alignedChart = lawAlignedChart();
const K = 24;
const yearOn = (vals: (number | null)[]): number => Math.round(vals[K + 12] ?? 0);
const nYear = aligned.rows.filter((r) => r.index[K + 12] !== null).length;
const alignedData = JSON.stringify({ rows: aligned.rows.map((r) => ({ name: r.state, effective: r.effective, index: r.index })) });
const alignedChips = aligned.rows.map((r, i) => ({ i, name: r.state, when: monthShort(r.effective.slice(0, 7)) }));
const lawCards = lawsIn.map((l) => {
  const a = aroundLaw(l.state, l.effective);
  return {
    href: `/laws/${l.state.toLowerCase()}/`,
    name: stateName(l.state),
    effective: l.effective,
    svg: smallMultiple(l.state, l.effective),
    note: `${fmt(a.before)} a year before, ${fmt(a.at)} on the day` + (a.after !== null ? `, ${fmt(a.after)} a year after` : ''),
  };
});
const lawsNoDate = H.laws.filter((l) => !l.effective && !lawsIn.some((x) => x.state === l.state));

const parts = [
  { id: 'count', label: 'The count' },
  { id: 'pharmacies', label: 'Fewer pharmacies, more ties' },
  { id: 'distance', label: 'Across state lines' },
  { id: 'chains', label: 'Which pharmacies' },
  { id: 'holders', label: 'Who holds them' },
  { id: 'laws', label: 'The states step in' },
];
---

<Base
  title="The 340B registry since 2010"
  bleed
  crumbs={[{ name: 'Registry history', path: '/registry/' }]}
  description={`Contract pharmacy arrangements in the federal 340B registry, month by month since January 2010: ${fmt(arr)} on ${monthLong(last)}, ${pct(out / arr)} with a pharmacy in another state. Rebuilt from the dates the registry records.`}
>
  <header class="rx-head">
    <div class="wrap">
      <p class="rx-kicker"><span class="dot" aria-hidden="true"></span>340B <span aria-hidden="true">/</span> Registry history</p>
      <h1>How 340B reached the pharmacy counter</h1>
      <p class="rx-lede">
        Clinics and hospitals in the 340B program may send their discounted drugs through outside pharmacies, under a contract each one registers with the federal government. The registry keeps the day each contract began and the day it ended. Counted month by month, those dates tell a story no single day of the registry shows.
      </p>
      <div class="rx-figures">
        <div class="rx-hero-fig">
          <p class="rx-hero-value">{fmt(arr)}</p>
          <p class="rx-hero-label">contract pharmacy arrangements on {monthLong(last)}</p>
        </div>
        <dl class="rx-stats">
          <div><dt>Distinct pharmacies</dt><dd>{fmt(ph)}</dd></div>
          <div><dt>Covered entities and sites</dt><dd>{fmt(ent)}</dd></div>
          <div><dt>Pharmacy in another state</dt><dd>{pct(out / arr)}</dd></div>
          <div><dt>Arrangements on {monthLong(first)}</dt><dd>{fmt(at(N.arrangements, first))}</dd></div>
        </dl>
      </div>
    </div>
  </header>

  <nav class="rx-parts wrap" aria-label="Parts of this page">
    <ol>{parts.map((p, i) => <li><a href={`#${p.id}`}><span class="rx-part-n">{i + 1}</span>{p.label}</a></li>)}</ol>
  </nav>

  <section class="rx-section" id="count" aria-labelledby="count-h">
    <div class="wrap">
      <p class="rx-step">1</p>
      <h2 id="count-h">The count</h2>
      <p class="rx-text">
        In January 2010 the registry records {fmt(at(N.arrangements, first))} contract pharmacy arrangements in force. That March, the federal government let every covered entity use as many outside pharmacies as it liked. By January 2016 there were {fmt(at(N.arrangements, y16))}, and on {monthLong(last)} there are {fmt(arr)}.
      </p>
      <div class="rx-story" data-story>
        <div class="rx-story-pin">
          <figure class="rx-figure rx-story-fig" data-chart="hero" data-chart-json={hero.data} data-story-fig>
            <Fragment set:html={hero.wide} />
            <Fragment set:html={hero.narrow} />
          </figure>
        </div>
        <ol class="rx-story-steps">
          {storySteps.map((st) => (
            <li class="rx-story-step" data-upto={st.upto}>
              <p class="rx-story-year">{st.year}</p>
              <p class="rx-story-text">{st.text}</p>
            </li>
          ))}
        </ol>
      </div>
      <figure class="rx-figure rx-story-after">
        <ul class="rx-legend rx-cohort-key" aria-label="Year the arrangement began">
          <li class="rx-cohort-strip" aria-hidden="true">{COHORTS.years.map((_, j) => <span class={`rx-ck ck${j}`}></span>)}</li>
          <li>Each band: the arrangements that began in one year, from {COHORTS.years[0]} or before, at the bottom, to {COHORTS.years.at(-1)}, on the surface</li>
        </ul>
        <p class="rx-small rx-cohort-note">Of the {fmt(arr)} arrangements in force today, {fmt(recent)} ({pct(recent / arr)}) began in 2024 or later. The bands thin as arrangements end: of those that began in 2020, {pct(kept20)} of the high point are still in force.</p>
        <figcaption>
          Arrangements in force on the first day of each month, as the registry records them on {monthLong(last)}. Shaded: before 2017 the registry no longer lists every arrangement that ended, so those months count fewer than were in force. The saw teeth are real: new arrangements begin on the first day of a quarter, and endings fall in every month.
        </figcaption>
      </figure>
      {
        fed.length > 0 && (
          <ol class="rx-events">
            {fed.map((e) => (
              <li>
                <time datetime={e.date}>{monthShort(e.date.slice(0, 7))}</time>
                <span>{e.text} {e.url && <a href={e.url}>Source</a>}</span>
              </li>
            ))}
          </ol>
        )
      }
      <details class="rx-table">
        <summary>The figures, each January</summary>
        <table>
          <caption>Contract pharmacy arrangements, pharmacies and entities on 1 January of each year</caption>
          <thead><tr><th scope="col">Day</th><th scope="col">Arrangements</th><th scope="col">Pharmacies</th><th scope="col">Entities and sites</th></tr></thead>
          <tbody>
            {H.months.filter((m) => m.endsWith('-01')).concat(last.endsWith('-01') ? [] : [last]).map((m) => (
              <tr><th scope="row">{monthLong(m)}</th><td>{fmt(at(N.arrangements, m))}</td><td>{fmt(at(N.pharmacies, m))}</td><td>{fmt(at(N.entities, m))}</td></tr>
            ))}
          </tbody>
        </table>
      </details>
    </div>
  </section>

  <section class="rx-section rx-alt" id="pharmacies" aria-labelledby="pharmacies-h">
    <div class="wrap">
      <p class="rx-step">2</p>
      <h2 id="pharmacies-h">Fewer pharmacies, more ties</h2>
      <p class="rx-text">
        The number of distinct pharmacies stopped growing around {monthShort(phPeakMonth)}, at {fmt(phPeak)}. The arrangements kept growing. So each pharmacy now serves more covered entities: {perPharmacy[H.months.indexOf('2012-01')]!.toFixed(1)} arrangements for each pharmacy in January 2012, {perPharmacy[perPharmacy.length - 1]!.toFixed(1)} today.
      </p>
      <div class="rx-pair">
        <figure class="rx-figure" data-chart="pharm" data-chart-json={pharmacies.data}>
          <p class="rx-fig-title">Distinct contract pharmacies</p>
          <Fragment set:html={pharmacies.wide} />
          <Fragment set:html={pharmacies.narrow} />
            </figure>
        <figure class="rx-figure" data-chart="ratio" data-chart-json={ratio.data}>
          <p class="rx-fig-title">Arrangements for each pharmacy</p>
          <Fragment set:html={ratio.wide} />
          <Fragment set:html={ratio.narrow} />
            </figure>
      </div>
      <div class="rx-callout">
        <p class="rx-callout-num">{fmt(bigPh)}</p>
        <p class="rx-callout-text">pharmacies, {pct(bigPh / phNow, 1)} of all {fmt(phNow)}, now hold {fmt(bigArr)} arrangements: {pct(bigArr / arr)} of the total. In January 2012 no pharmacy held even 50.</p>
      </div>
      <figure class="rx-figure" data-chart="conc" data-chart-json={conc.data}>
        <p class="rx-fig-title">Where the arrangements sit, by how many each pharmacy holds</p>
        <Fragment set:html={conc.wide} />
        <Fragment set:html={conc.narrow} />
        <figcaption>Each band: the share of all arrangements held by pharmacies of one size, counted afresh each month. The strongest color, at the bottom: pharmacies with 200 or more arrangements each.</figcaption>
      </figure>
    </div>
  </section>

  <section class="rx-section" id="distance" aria-labelledby="distance-h">
    <div class="wrap">
      <p class="rx-step">3</p>
      <h2 id="distance-h">Across state lines</h2>
      <p class="rx-text">
        In January 2012, {pct(share[H.months.indexOf('2012-01')]!, 1)} of arrangements joined an entity to a pharmacy in another state. On {monthLong(last)} it is {pct(share[share.length - 1]!)}: {fmt(out)} arrangements. Most of the distance runs to a few states where mail-order and specialty pharmacies sit.
      </p>
      <figure class="rx-figure" data-chart="dist" data-chart-json={distance.data}>
        <Fragment set:html={distance.wide} />
        <Fragment set:html={distance.narrow} />
        <ul class="rx-legend">
          <li><span class="rx-key oi" aria-hidden="true"></span>At insurer-owned pharmacies</li>
          <li><span class="rx-key oo" aria-hidden="true"></span>At all other pharmacies</li>
        </ul>
        <figcaption>The pharmacy's state is from its address in the registry; the entity's is from its street address. Insurer-owned: specialty, mail and infusion pharmacies whose name ties them to a company that also owns a health insurer or pharmacy benefit manager.</figcaption>
      </figure>

      <h3 class="rx-sub-h">Whose pharmacies cross the line</h3>
      <p class="rx-text">
        Most of the distance belongs to one kind of pharmacy. {pct(insRate(last))} of arrangements at insurer-owned specialty and mail pharmacies cross a state line, against {pct(otherRate(last))} of all the rest. In January 2017 those pharmacies held {pct(insPartOf('2017-01'))} of the out-of-state arrangements; on {monthLong(last)} they hold {pct(insPartOf(last))}. Leave them out, and the share of arrangements in another state was {pct(otherRate('2019-01'), 1)} in January 2019 and {pct(otherRate('2023-01'), 1)} in January 2023.
      </p>
      <p class="rx-small">What this means for clinics, insurers and the laws: <a href="/writing/whose-pharmacies/">Whose pharmacies?</a>, an analysis.</p>
      <details class="rx-table">
        <summary>The figures, each January</summary>
        <table>
          <caption>Arrangements with a pharmacy in another state, by who owns the pharmacy, on 1 January of each year</caption>
          <thead><tr><th scope="col">Day</th><th scope="col">In another state</th><th scope="col">Insurer-owned part</th><th scope="col">Other arrangements in another state</th></tr></thead>
          <tbody>
            {insRows.map((r) => (
              <tr><th scope="row">{r.day}</th><td>{r.out}</td><td>{r.part}</td><td>{r.other}</td></tr>
            ))}
          </tbody>
        </table>
        <p class="rx-small">Insurer-owned arrangements on {monthLong(last)}, {fmt(insNow)} in all: {ownersLine}.</p>
      </details>

      <div class="rx-compare" data-compare data-lapse={lapse}>
      <h3 class="rx-sub-h">Every state, then and now</h3>
      <p class="rx-small">Each state's share of its entities' arrangements with a pharmacy in another state. Both maps use the same scale. The typical state went from {pct(medThen)} in {y17.slice(0, 4)} to {pct(medNow)} today.</p>
      <div class="rx-story rx-story-map" data-story data-story-map>
        <div class="rx-story-pin">
          <div class="rx-lapse" hidden data-lapse-controls>
            <button type="button" class="rx-play" data-play aria-label="Play the years from 2010"><span class="rx-play-icon" aria-hidden="true"></span><span data-play-label>Play</span></button>
            <label class="rx-range">
              <span class="visually-hidden">Year of the left map</span>
              <span class="rx-range-end" aria-hidden="true">2010</span>
              <input type="range" min="0" step="1" data-year-range />
              <span class="rx-range-end" aria-hidden="true">{last.slice(0, 4)}</span>
            </label>
            <p class="rx-lapse-note" data-lapse-note aria-live="polite"></p>
          </div>
          <div class="rx-maps" data-maps>
            <div class="rx-map-switch" role="group" aria-label="Year of the map" hidden data-map-switch>
              <button type="button" aria-pressed="false" data-map="then">{monthShort(y17)}</button>
              <button type="button" aria-pressed="true" data-map="now">{monthShort(last)}</button>
            </div>
            <figure class="rx-map" data-map-panel="then">
              <p class="rx-map-year" data-then-year>{y17.slice(0, 4)}</p>
              <Fragment set:html={mapThen} />
            </figure>
            <figure class="rx-map" data-map-panel="now">
              <p class="rx-map-year">Today <span>{monthShort(last)}</span></p>
              <Fragment set:html={mapNow} />
            </figure>
          </div>
          <ul class="rx-legend rx-legend-seq rx-share-key">
            {shareKey.map((k) => <li><span class={`rx-key ${k.cls}`} aria-hidden="true"></span>{k.label}</li>)}
            <li><span class="rx-key sh-few" aria-hidden="true"></span>Fewer than 50 arrangements</li>
          </ul>
        </div>
        <ol class="rx-story-steps">
          {mapSteps.map((st) => (
            <li class:list={['rx-story-step', { 'rx-story-narrow': st.narrow }]} data-month={st.month}>
              <p class="rx-story-year">{st.label ?? `January ${st.year}`}</p>
              <p class="rx-story-text">{st.text}</p>
            </li>
          ))}
        </ol>
      </div>

      <div class="rx-two">
        <div>
          <h3>Where the pharmacies are</h3>
          <p class="rx-small">Arrangements reaching a state's pharmacies from entities in other states. {fl.state}'s went from {fmt(fl.then)} in {y17.slice(0, 4)} to {fmt(fl.now)}.</p>
          <ol class="rx-pbars">
            {receiving.map((r) => (
              <li>
                <span class="rx-bar-label">{r.state}</span>
                <span class="rx-pbar"><span class={`rx-pbar-fill then ${bw(r.then)}`} data-then-bar={r.code}></span><span class={`rx-pbar-fill now ${bw(r.now)}`}></span></span>
                <span class="rx-pbar-values"><span data-then-value={r.code}>{fmt(r.then)}</span><strong>{fmt(r.now)}</strong></span>
              </li>
            ))}
          </ol>
          <ul class="rx-legend">
            <li><span class="rx-key pthen" aria-hidden="true"></span><span data-then-label>{monthShort(y17)}</span></li>
            <li><span class="rx-key pnow" aria-hidden="true"></span>{monthShort(last)}</li>
          </ul>
        </div>
        <div>
          <h3>The pairs of states</h3>
          <table class="rx-mini rx-pairs">
            <caption class="visually-hidden">Arrangements across a state line, by pair of states, {monthLong(last)}</caption>
            <thead><tr><th scope="col">Entity's state</th><th scope="col">Pharmacy's state</th><th scope="col">Arrangements</th></tr></thead>
            <tbody>{pairs.map((p) => <tr><td>{p.from}</td><td>{p.to}</td><td>{fmt(p.n)}</td></tr>)}</tbody>
          </table>
        </div>
      </div>
      </div>
    </div>
  </section>

  <section class="rx-section rx-alt" id="chains" aria-labelledby="chains-h">
    <div class="wrap">
      <p class="rx-step">4</p>
      <h2 id="chains-h">Which pharmacies</h2>
      <p class="rx-text">
        For most of the decade Walgreens held more arrangements than any other chain.{cvsOver && <> CVS passed it in {monthShort(cvsOver)}.</>} The mail-order and specialty pharmacies are few but each is tied to hundreds of entities: {fmt(mailPh)} pharmacies hold {fmt(mailArr)} arrangements.
      </p>
      <figure class="rx-figure" data-chart="chains" data-chart-json={chains.data}>
        <Fragment set:html={chains.wide} />
        <Fragment set:html={chains.narrow} />
        <ul class="rx-legend">{chainSeries.map((s) => <li><span class={`rx-key s${s.slot}`} aria-hidden="true"></span>{s.label}</li>)}</ul>
        <figcaption>Groups are read from each pharmacy's name and the name it does business as, in the registry. Mail-order and specialty: Express Scripts and Accredo, Optum, AcariaHealth, CenterWell. Other: every pharmacy whose name names none of these.</figcaption>
      </figure>
      <table class="rx-mini rx-mail">
        <caption>Mail-order and specialty, {monthLong(last)}</caption>
        <thead><tr><th scope="col">Group</th><th scope="col">Pharmacies</th><th scope="col">Arrangements</th><th scope="col">For each pharmacy</th></tr></thead>
        <tbody>{mail.map(([g, d]) => <tr><td>{g}</td><td>{fmt(d.pharmacies)}</td><td>{fmt(d.arrangements)}</td><td>{fmt(d.arrangements / Math.max(d.pharmacies, 1))}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="rx-section" id="holders" aria-labelledby="holders-h">
    <div class="wrap">
      <p class="rx-step">5</p>
      <h2 id="holders-h">Who holds them</h2>
      <p class="rx-text">
        Health centers hold {fmt(at(T.arrangements['Health centers']!, last))} arrangements, hospitals {fmt(at(T.arrangements.Hospitals!, last))}, and the other federal grantees (Ryan White clinics, sexually transmitted disease and tuberculosis clinics, family planning clinics and others) {fmt(at(T.arrangements['Other federal grantees']!, last))}.
      </p>
      <figure class="rx-figure" data-chart="types" data-chart-json={types.data}>
        <Fragment set:html={types.wide} />
        <Fragment set:html={types.narrow} />
        <ul class="rx-legend">{T.groups.map((g, i) => <li><span class={`rx-key s${i + 1}`} aria-hidden="true"></span>{g}</li>)}</ul>
        <figcaption>Health centers: health center program grantees, look-alikes and tribal health centers. Hospitals: disproportionate share, critical access, children's, cancer, rural referral and sole community hospitals. A hospital's contract usually covers its outpatient sites, which are not counted again.</figcaption>
      </figure>
    </div>
  </section>

  <section class="rx-section rx-alt" id="laws" aria-labelledby="laws-h">
    <div class="wrap">
      <p class="rx-step">6</p>
      <h2 id="laws-h">The states step in</h2>
      <p class="rx-text">
        From July 2020 several drug makers limited the 340B price at contract pharmacies. Starting with Arkansas in 2021, states passed laws that bar those limits. The ClinX table of state laws holds {H.laws.length} such laws in {new Set(H.laws.map((l) => l.state)).size} states.
      </p>
      <div class="rx-lawmap">
        <Fragment set:html={lawMap()} />
        <ul class="rx-legend rx-legend-seq">
          <li><span class="rx-key ly2021" aria-hidden="true"></span>2021</li>
          <li><span class="rx-key ly2022" aria-hidden="true"></span>2022</li>
          <li><span class="rx-key ly2023" aria-hidden="true"></span>2023</li>
          <li><span class="rx-key ly2024" aria-hidden="true"></span>2024</li>
          <li><span class="rx-key ly2025" aria-hidden="true"></span>2025</li>
          <li><span class="rx-key ly2026" aria-hidden="true"></span>2026</li>
          {H.laws.some((l) => !l.effective) && <li><span class="rx-key lpend" aria-hidden="true"></span>Law, date not printed</li>}
        </ul>
      </div>
      <h3 class="rx-sub-h">Every law state on one clock</h3>
      <p class="rx-small">Each line is one state: the arrangements its entities hold, set to 100 in the month its law took effect, from two years before to two years after. The bold line is the median law state; the dashed line is the whole country over the same months. Both stop where fewer than five states have reached that month. A year after its law, the median state stood at {yearOn(aligned.median)} and the country at {yearOn(aligned.nation)} ({nYear} states have a full year since).</p>
      <figure class="rx-figure rx-aligned" data-aligned={alignedData}>
        <Fragment set:html={alignedChart.wide} />
        <Fragment set:html={alignedChart.narrow} />
        <div class="la-pick" hidden data-la-pick>
          <p class="la-pick-label">Point at a line, or pick a state:</p>
          <ul class="la-chips">
            {alignedChips.map((c) => (
              <li><button type="button" class="la-chip" data-la={c.i} aria-pressed="false">{c.name} <span>{c.when}</span></button></li>
            ))}
          </ul>
        </div>
        <ul class="rx-legend">
          <li><span class="rx-key la-k-state" aria-hidden="true"></span>One law state</li>
          <li><span class="rx-key la-k-med" aria-hidden="true"></span>Median law state</li>
          <li><span class="rx-key la-k-nat" aria-hidden="true"></span>The country, same months</li>
        </ul>
      </figure>
      <h3 class="rx-sub-h">State by state</h3>
      <p class="rx-small">Arrangements held by the state's entities, by month from January 2018. Each chart has its own scale; the number in its corner is its largest month. The dot and line mark the day the law took effect.</p>
      <ul class="rx-multiples">
        {lawCards.map((c) => (
          <li>
            <p class="sm-name"><a href={c.href}>{c.name}</a> <span>{c.effective}</span></p>
            <Fragment set:html={c.svg} />
            <p class="sm-note">{c.note}</p>
          </li>
        ))}
      </ul>
      {lawsNoDate.length > 0 && <p class="rx-small">Not charted, because the saved text of the law prints no effective date: {lawsNoDate.map((l) => stateName(l.state)).join(', ')}.</p>}
    </div>
  </section>

  <footer class="rx-source">
    <div class="wrap rx-measure">
      <p>Source: U.S. Health Resources and Services Administration, Office of Pharmacy Affairs, 340B OPAIS, Covered Entity Daily Export of 23 November 2026, rebuilt month by month. Counts before 2017 are a lower bound, and owners are matched by pharmacy name, since the registry records none. The page shows what the registry records, not what any law caused. How it is counted, with the code: <a href={`${REGISTRY_REPO}#readme`}>the repository's notes</a>.</p>
    </div>
  </footer>
</Base>

<script>
  import '../../scripts/registry-charts';
</script>
