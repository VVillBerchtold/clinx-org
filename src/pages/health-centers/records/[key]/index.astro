---
import RecordsCenterPage from '../../../../components/hc/RecordsCenterPage.astro';
import { centerKeys, lastYearOf, slugOf } from '../../../../lib/hc-records';

/** A health center's latest report (2025 for nearly all): /health-centers/records/<key>/. */
export function getStaticPaths() {
  // A health center's short address shows the latest report HRSA's files hold for it.
  return centerKeys().map((key) => ({ params: { key: slugOf(key) }, props: { centerKey: key, year: lastYearOf(key) } }));
}
const { centerKey, year } = Astro.props;
---

<RecordsCenterPage centerKey={centerKey} year={year} />
