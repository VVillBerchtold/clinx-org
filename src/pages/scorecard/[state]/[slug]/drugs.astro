---
import '../../../../styles/drugs.css';
import Base from '../../../../layouts/Base.astro';
import Cited from '../../../../components/Cited.astro';
import Draft from '../../../../components/Draft.astro';
import PageHead from '../../../../components/PageHead.astro';
import Pager from '../../../../components/Pager.astro';
import { buildDrugViews, compareNames, formatDate, getDataset, pdfHref, printedNote, type DrugRow, type DrugView } from '../../../../lib/data';
import { drawFigure } from '../../../../lib/money';
import { CLAIMS_WORDS, claimsKey, claimsSortValue, countCodes, ndcSplit } from '../../../../lib/drugs';
import { fdaNameForCell, fdaShown, getFdaNames } from '../../../../lib/fda-names';
import { filedDrugShown } from '../../../../lib/filed-drug-display';
import { barPercentOfScale } from '../../../../lib/meter';
import { stateName } from '../../../../lib/states';

/**
 * One page per filing whose form has a drug schedule (Rhode Island's Schedule G). Every row is in the HTML,
 * in the order filed. The toolbar is hidden until src/scripts/drug-table.ts turns it on; without the script
 * the page is a plain table. A claim count of 1 to 5 is never held, so none is printed here: a row whose
 * count is left out says "fewer than 6" and carries one fixed sort value, the same on every such row.
 *
 * Under a row's code sits the name the FDA's National Drug Code Directory lists for it, when the code is filed
 * as one 11-digit code and the directory lists it. That line is the FDA's and says so; the name above it is the filer's.
 */
export function getStaticPaths() {
  const views = buildDrugViews(getDataset());
  return views.map((view) => {
    // The drug pages beside this one: same state, same year, A to Z by name as filed.
    const set = views
      .filter((v) => v.entity.state === view.entity.state && v.filing.reportingYear === view.filing.reportingYear)
      .sort((a, b) => compareNames(a.entity.nameAsFiled, b.entity.nameAsFiled));
    const at = set.indexOf(view);
    const step = (v: DrugView | undefined) => (v ? { href: v.path, name: v.entity.nameAsFiled } : undefined);
    return {
      params: { state: view.entity.state.toLowerCase(), slug: view.entity.slug },
      props: { view, prev: step(set[at - 1]), next: step(set[at + 1]) },
    };
  });
}

interface Props {
  view: DrugView;
  prev: { href: string; name: string } | undefined;
  next: { href: string; name: string } | undefined;
}

const { view, prev, next } = Astro.props;
const { entity, filing, spec, drug, rows, below, total } = view;
const name = entity.nameAsFiled;
const state = stateName(entity.state);
const year = filing.reportingYear;
const count = rows.length;
const countText = count.toLocaleString('en-US');
const noun = count === 1 ? drug.noun : drug.nounPlural;
const tone = entity.entityType === 'hospital' ? 'hosp' : 'hc';
const pdf = (page: number) => pdfHref(filing, page);
const cite = (r: DrugRow, what: string) => `${drug.scheduleName}, ${what}, page ${r.page} of the ${spec.noun} PDF`;
const amountLabel = (r: DrugRow) => cite(r, `line ${r.line}`);
const footName = (r: DrugRow) => r.labelAsFiled || r.nameAsFiled;
const footNote = (r: DrugRow) => printedNote(r);
const fdaNames = getFdaNames();
const fdaRowCount = rows.filter((r) => fdaNameForCell(fdaNames, r.ndcAsFiled) !== null).length;
const percent = (cents: number) => (view.maxCents > 0 && cents > 0 ? barPercentOfScale(cents, view.maxCents) : null);
---

<Base
  title={`${name}: ${drug.nounPlural} in the ${year} 340B filing`}
  crumbs={[{ name: 'Scorecard', path: '/scorecard/' }, { name: state, path: `/scorecard/${entity.state.toLowerCase()}/` }, { name, path: Astro.url.pathname.replace(/drugs\/$/, '') }, { name: drug.nounPlural[0]!.toUpperCase() + drug.nounPlural.slice(1), path: Astro.url.pathname }]}
  description={`Every ${drug.noun} row of ${drug.scheduleName} of the ${name} 340B filing for calendar year ${year}, as filed, with its amount and number of claims. Search the rows. Every amount links to its page of the filing.`}
>
  <PageHead
    wide
    title={`${name}: ${drug.nounPlural}`}
    trail={[
      { label: 'Scorecard', href: '/scorecard/' },
      { label: state, href: `/scorecard/${entity.state.toLowerCase()}/` },
      { label: name, href: entity.path },
      { label: 'Drugs' },
    ]}
  >
    <p class="lede">{drug.scheduleName} of this filing lists {countText} {noun}, with an amount and a number of claims for each, as filed. Every amount links to its page of the filing.</p>
    <p class="lede">The schedule's total is printed as &ldquo;{total.labelAsFiled}&rdquo;. The filings describe the amounts in more than one way. <a href="/methods/">Methods</a> says more.</p>
    <div class="btn-row">
      <a class="btn ghost" href={entity.path}>Back to the filing</a>
      <a class="btn ghost" href={`/scorecard/${entity.state.toLowerCase()}/drugs/`}>Drugs across all filers</a>
    </div>
  </PageHead>

  <ul class="stats drug-stats" aria-label={`${drug.scheduleName} at a glance`}>
    <li><strong>{countText}</strong><span>{noun} listed</span></li>
    <li><strong><Cited value={`$${drawFigure(total.amountAsFiled, 'money')}`} href={pdf(total.page)} label={cite(total, 'printed total')} /></strong><span>Total as filed</span></li>
    <li><strong><Cited value={drawFigure(total.claimsAsFiled)} href={pdf(total.page)} label={cite(total, 'printed claims total')} /></strong><span>Claims total as filed</span></li>
    <li><strong>{view.fewerThan6.toLocaleString('en-US')}</strong><span>{view.fewerThan6 === 1 ? 'row shows' : 'rows show'} &ldquo;{CLAIMS_WORDS.fewer_than_6}&rdquo; for claims. <a href="/methods/#9-small-claim-counts">What this means</a></span></li>
  </ul>

  <div class="prose">
    <section class:list={['drug-section', `tone-${tone}`]} aria-labelledby="drug-rows-title" data-drug-tool data-scale={view.scale}>
      <h2 id="drug-rows-title">All {countText} {drug.noun} rows</h2>

      <div class="drug-sticky" data-drug-js hidden>
        <div class="drug-bar" role="search" aria-label={`Search and filter the ${drug.noun} rows`}>
          <div class="drug-search">
            <svg class="drug-mag" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="5.25" stroke="currentColor" stroke-width="2"></circle><path d="M12 12l4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
            <label class="visually-hidden" for="drug-q">Search drug name, ingredient, labeler or NDC</label>
            <input id="drug-q" type="search" placeholder="Search name, ingredient, labeler or NDC" autocomplete="off" spellcheck="false" enterkeyhint="search" aria-keyshortcuts="/" data-drug-q />
            <kbd aria-hidden="true">/</kbd>
          </div>
          <fieldset class="drug-seg">
            <legend class="visually-hidden">Rows to show</legend>
            <input type="radio" name="drug-show" id="drug-show-all" value="all" checked /><label for="drug-show-all">All rows</label>
            <input type="radio" name="drug-show" id="drug-show-s" value="s" /><label for="drug-show-s">Counts shown</label>
            <input type="radio" name="drug-show" id="drug-show-f" value="f" /><label for="drug-show-f">Fewer than 6</label>
          </fieldset>
          <label class="drug-sel">
            <span>Order</span>
            <select data-drug-order>
              <option value="filed" selected>As filed</option>
              <option value="amount-desc">Amount, largest first</option>
              <option value="amount-asc">Amount, smallest first</option>
              <option value="claims-desc">Claims, largest first</option>
              <option value="name">Name, A to Z</option>
            </select>
            <svg class="drug-chev" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false"><path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </label>
          <p class="drug-live" aria-live="polite" aria-atomic="true">
            <span class="drug-count" data-drug-count>Showing {countText} of {countText} rows</span>
            <span class="drug-sum" data-drug-sum></span>
          </p>
          <button type="button" class="btn ghost drug-clear is-off" data-drug-clear disabled>Clear</button>
        </div>
      </div>

      <div class="table-wrap drug-wrap">
        <table class="drug-table" data-drug-table data-count={count}>
          <caption><span>{drug.scheduleName} as filed, for {name}: {countText} {noun}, in the order filed</span></caption>
          <thead>
            <tr>
              <th scope="col" class="c-line">Line</th>
              <th scope="col" class="c-name">{drug.nameHeading}</th>
              <th scope="col" class="num c-amt">{drug.amountHeading}</th>
              <th scope="col" class="num c-claims">{drug.claimsHeading}</th>
            </tr>
          </thead>
          <tbody id="drug-rows">
            {
              rows.map((r) => {
                const ndc = ndcSplit(r.ndcAsFiled);
                const pct = percent(r.amountCents);
                const fda = fdaNameForCell(fdaNames, r.ndcAsFiled);
                const shown = fda ? fdaShown(fda) : null;
                const drawn = filedDrugShown(r.nameAsFiled);
                return (
                  <tr data-a={r.amountCents} data-c={claimsSortValue(r.claimsStatus, r.claims)} data-k={claimsKey(r.claimsStatus)}>
                    <td class="c-line">{r.line}</td>
                    <th scope="row">
                      {r.nameAsFiled === '' ? <span class="drug-name none">(no name printed)</span> : <span class="drug-name" data-typed={drawn !== r.nameAsFiled ? r.nameAsFiled : undefined}>{drawn}</span>}
                      {ndc && <span class="ndc">{ndc.shown}</span>}
                      {ndc && ndc.rest !== '' && (
                        <details class="ndc-more">
                          <summary>{countCodes(ndc.rest)} more</summary>
                          <span class="ndc">{ndc.rest}</span>
                        </details>
                      )}
                      {fda && shown && (
                        <span class="dg-fda dr-fda">
                          <span>Listed by the FDA as <span class="dg-as" data-drug-find>{shown.title}</span></span>
                          {shown.generic !== '' && <span data-drug-find>{shown.generic}</span>}
                          {shown.strength !== '' && <span>{shown.strength}</span>}
                          {shown.form !== '' && <span class="dg-form">{shown.form}</span>}
                          {shown.labeler !== '' && <span data-drug-find>{shown.labeler}</span>}
                          {fda.match === 'product' && <span>the product is listed, not this package</span>}
                          {fda.kept && <span>no longer in the directory; as listed on {formatDate(fda.listedOn)}</span>}
                        </span>
                      )}
                    </th>
                    <td class="num c-amt">
                      <Cited value={drawFigure(r.amountAsFiled, 'money')} href={pdf(r.page)} label={amountLabel(r)} />
                      <span class="track">{pct !== null && <svg class="bar" width={`${pct}%`} height="6" aria-hidden="true" focusable="false" />}</span>
                    </td>
                    <td class="num c-claims">
                      {r.claimsStatus === 'count' ? (
                        drawFigure(r.claimsAsFiled)
                      ) : r.claimsStatus === 'fewer_than_6' ? (
                        <span class="drug-pill">{CLAIMS_WORDS.fewer_than_6}<span class="visually-hidden"> (the count is not shown)</span></span>
                      ) : (
                        <span class="drug-pill">{CLAIMS_WORDS.beside_small}</span>
                      )}
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
          <tbody class="drug-empty" hidden>
            <tr>
              <td colspan="4">
                <p>No row matches.</p>
                <button type="button" class="btn ghost drug-clear" data-drug-clear>Clear</button>
              </td>
            </tr>
          </tbody>
          <tfoot>
            {
              below && (
                <tr class="foot-under">
                  <th scope="row" colspan="2">{footName(below)}</th>
                  <td class="num c-amt"><Cited value={drawFigure(below.amountAsFiled, 'money')} href={pdf(below.page)} label={cite(below, 'row for amounts under $5,000')} /></td>
                  <td class="num c-claims"><Cited value={drawFigure(below.claimsAsFiled)} href={pdf(below.page)} label={cite(below, 'claims on the row for amounts under $5,000')} /></td>
                </tr>
              )
            }
            <tr class="foot-total">
              <th scope="row" colspan="2">
                {total.labelAsFiled}
                {footNote(total) !== '' && <small class="subline">{footNote(total)}</small>}
              </th>
              <td class="num c-amt"><Cited value={drawFigure(total.amountAsFiled, 'money')} href={pdf(total.page)} label={cite(total, 'printed total')} /></td>
              <td class="num c-claims"><Cited value={drawFigure(total.claimsAsFiled)} href={pdf(total.page)} label={cite(total, 'printed claims total')} /></td>
            </tr>
          </tfoot>
        </table>
      </div>
      <p class="small muted" data-drug-js hidden>The rows at the foot of the table are always shown. The sum above does not include them.</p>
    </section>

    <div class="note">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="8.5" stroke="currentColor" stroke-width="2"></circle><path d="M10 9v5M10 6v.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      <div>
        <p><strong>What &ldquo;{CLAIMS_WORDS.fewer_than_6}&rdquo; means.</strong> A count of 1 to 5 is not shown on this site or in its data files. <a href="/methods/#9-small-claim-counts">Methods, section 9</a>, says how.</p>
        <p>Amounts and counts are the filer&rsquo;s own, in US dollars. They are written here with commas between thousands, and an amount filed with one decimal place is written with two. No value is changed: the filing and the download keep each figure as typed. <Draft /></p>
        <p><strong>Drug names are the filer&rsquo;s own words.</strong> Filers type them in many ways, so this page writes them one way: capitals, spaces, unit names such as mg and mL, a zero before a decimal point, and commas in long numbers. No word is changed, spelled out or left out, and shorthand stays as the filer typed it. The filing and the download keep each name as typed, and a search here reads both. <Draft /></p>
        {
          fdaRowCount > 0 && (
            <p>
              <strong>&ldquo;Listed by the FDA as&rdquo; is not part of the filing.</strong> It is the name, ingredient, strength, form and labeler that the U.S. Food and Drug Administration&rsquo;s <a href={fdaNames.source.page} rel="noopener">National Drug Code Directory</a> lists for the row&rsquo;s code, as downloaded on {formatDate(fdaNames.source.retrieved)}. {fdaRowCount === count ? `All ${countText} rows have one.` : `${fdaRowCount.toLocaleString('en-US')} of the ${countText} rows have one.`} A row has none when its code is not filed as one 11-digit code or the directory has never listed it. Where the directory has since dropped a code, the name is kept as it was last listed, and the line says so. The directory&rsquo;s capitals, strengths and unit names are written one way on this page. <a href={`/scorecard/${entity.state.toLowerCase()}/drugs/#how`}>How a code is matched</a> <Draft />
            </p>
          )
        }
      </div>
    </div>

    <h2 id="source">Source</h2>
    <dl class="facts panel">
      <dt>Filing PDF</dt>
      <dd><a href={pdfHref(filing, view.firstPage)}>Open {drug.scheduleName} on the {spec.publisher}</a></dd>
      <dt>SHA-256</dt>
      <dd><span class="mono">{filing.pdfSha256}</span></dd>
      <dt>Retrieved</dt>
      <dd>{formatDate(filing.retrievedAt)}</dd>
      <dt>Pages used</dt>
      <dd>{view.firstPage === view.lastPage ? view.firstPage : `${view.firstPage} to ${view.lastPage}`} of {filing.pageCount}</dd>
    </dl>
  </div>

  <Pager
    label="More drug pages"
    noun="filer's drugs"
    prev={prev}
    next={next}
    up={{ href: `/scorecard/${entity.state.toLowerCase()}/drugs/`, label: `Drugs across all ${state} filers` }}
  />

  <script>
    import '../../../../scripts/drug-table';
  </script>
</Base>
