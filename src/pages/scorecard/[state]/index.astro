---
import FilingStatePage from '../../../components/FilingStatePage.astro';
import ReportStatePage from '../../../components/ReportStatePage.astro';
import TotalsStatePage from '../../../components/TotalsStatePage.astro';
import { buildReportViews, buildTotalsViews, buildViews, getDataset } from '../../../lib/data';

/**
 * One page per state. The kind of record the state's rows are decides the page: a state whose filers
 * file for themselves gets the table of filings; a state that prints a report about its entities gets
 * that report's page; a state that prints statewide totals only gets the page of totals. Nothing here
 * looks at a state's code.
 */
export function getStaticPaths() {
  const data = getDataset();
  const filingStates = [...new Set(buildViews(data).map((v) => v.entity.state))];
  const reportStates = buildReportViews(data).map((v) => v.state);
  const totalsStates = buildTotalsViews(data).map((v) => v.state);
  const all = [...filingStates, ...reportStates, ...totalsStates];
  const twice = all.filter((c, i) => all.indexOf(c) !== i);
  if (twice.length > 0) throw new Error(`${twice.join(', ')}: a state cannot have more than one kind of page`);
  return [
    ...filingStates.map((code) => ({ params: { state: code.toLowerCase() }, props: { code, kind: 'filings' as const } })),
    ...reportStates.map((code) => ({ params: { state: code.toLowerCase() }, props: { code, kind: 'report' as const } })),
    ...totalsStates.map((code) => ({ params: { state: code.toLowerCase() }, props: { code, kind: 'totals' as const } })),
  ];
}

interface Props {
  code: string;
  kind: 'filings' | 'report' | 'totals';
}

const { code, kind } = Astro.props;
---

{kind === 'totals' ? <TotalsStatePage code={code} /> : kind === 'report' ? <ReportStatePage code={code} /> : <FilingStatePage code={code} />}
