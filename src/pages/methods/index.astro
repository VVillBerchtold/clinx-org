---
import '../../styles/pages.css';
import Base from '../../layouts/Base.astro';
import OnPage from '../../components/OnPage.astro';
import PageHead from '../../components/PageHead.astro';
import { buildViews, buildWorkbookViews, comparabilityFollowOns, comparabilityParagraph, compareNames, formatFigure, getDataset } from '../../lib/data';
import { anyFormSpec } from '../../lib/forms';
import { renderInline, renderSections } from '../../lib/markdown';
import { drawFiguresInText } from '../../lib/money';
import { stateName } from '../../lib/states';
import { HC_HOME } from '../../lib/site';
import { recordsSource } from '../../lib/hc-records';
import { FUNDING_HOME } from '../../lib/hc-funding';
import { AREAS_PATH } from '../../lib/hc-areas';

const data = getDataset();
const views = buildViews(data);
const byFiling = new Map(views.map((v) => [v.filing.filingId, v]));
// A workbook's differences are on that workbook's own page, under HRSA's name.
const workbooks = new Map(buildWorkbookViews(data).map((b) => [b.filing.filingId, b]));
// A difference in a state's report belongs to a row of that report: it is named by the entity and links to the state's page.
const filingById = new Map(data.filings.map((f) => [f.filingId, f]));
const entityById = new Map(data.entities.map((e) => [e.entityId, e]));
const whose = (filingId: string): { name: string; href: string } | null => {
  const v = byFiling.get(filingId);
  if (v) return { name: v.entity.nameAsFiled, href: `${v.entity.path}#differences` };
  const book = workbooks.get(filingId);
  if (book) return { name: book.title, href: `${book.path}#differences` };
  const f = filingById.get(filingId);
  const e = f && entityById.get(f.entityId);
  if (!f || !e) return null;
  // A state that has an earlier year's report keeps that year's differences on the year's own page.
  const spec = anyFormSpec(f.form);
  const twoYears = spec.layout === 'state-report' && spec.earlier !== undefined;
  const onEarlier = spec.layout === 'state-report' && spec.earlier?.year === f.reportingYear;
  const where = onEarlier ? `/scorecard/${f.state.toLowerCase()}/${f.reportingYear}/` : `/scorecard/${f.state.toLowerCase()}/`;
  const totals = twoYears ? `${stateName(f.state)}: statewide totals, ${f.reportingYear} data` : `${stateName(f.state)}: statewide totals`;
  return { name: f.recordKind === 'state_report_totals' ? totals : e.nameAsFiled, href: `${where}#differences` };
};

// The comparability paragraph gets its own heading below, so it is taken out of section 5 here.
const paragraph = comparabilityParagraph(data);
const followOns = comparabilityFollowOns(data);
const sections = renderSections(followOns.reduce((text, p) => text.replace(p, ''), data.methodsMarkdown.replace(paragraph, '')));
const intro = sections.find((s) => s.title === '');
const numbered = sections.filter((s) => s.title !== '');

const differences = [...data.discrepancies].sort((a, b) => {
  const nameA = whose(a.filingId)?.name ?? a.filingId;
  const nameB = whose(b.filingId)?.name ?? b.filingId;
  return compareNames(nameA, nameB) || a.rule.localeCompare(b.rule);
});
const records = recordsSource();
const recordYears = `${records.years[0]} to ${records.latest_year}`;
const readTwice = Object.values(records.workbooks).every((w) => w.reads === 'two_reads');
const formCount = differences.filter((d) => d.basis === 'form').length;
const comparisonCount = differences.length - formCount;
---

<Base
  title="Methods: how the 340B figures are sourced and checked"
  crumbs={[{ name: 'Methods', path: '/methods/' }]}
  description="Where the figures come from, how they were checked, how each measure is calculated, every difference found between the figures of one filing or report, and how the health centers pages are made."
>
  <PageHead title="Methods" trail={[{ label: '340B Scorecard' }]}>
    <p class="lede">Where the figures come from, how they were checked, and how each measure is calculated.</p>
    <OnPage title="Methods" items={[...numbered.map((s) => ({ id: s.id, label: s.title.replace(/^\d+\.\s*/, '') })), { id: 'health-centers', label: 'Health centers' }, { id: 'fetching', label: 'How ClinX fetches public files' }]} />
  </PageHead>

  <div class="prose doc-page">
  {intro && <Fragment set:html={intro.html} />}

  {
    numbered.map((s) => (
      <>
        <h2 id={s.id}>{s.title}</h2>
        <Fragment set:html={s.html} />

        {s.title.startsWith('4.') && (
          <>
            <h3 id="all-differences">All differences, by filing</h3>
            <p>
              {differences.length} differences across {new Set(differences.map((d) => d.filingId)).size} filings, reports and report rows: {formCount} under a <code>form</code> rule and {comparisonCount} under a <code>comparison</code> rule. Nothing was changed; both figures are kept as filed.
            </p>
            <div class="table-wrap wide all-differences" tabindex="0" role="group" aria-label="All differences, a table that scrolls sideways">
              <table>
                <caption><span>Every difference found between two figures in one filing or report</span></caption>
                <thead>
                  <tr>
                    <th scope="col">Filing or report row</th>
                    <th scope="col">Rule</th>
                    <th scope="col">Basis</th>
                    <th scope="col" class="num">Expected</th>
                    <th scope="col" class="num">Filed</th>
                    <th scope="col" class="num">Difference</th>
                    <th scope="col">Note</th>
                  </tr>
                </thead>
                <tbody>
                  {differences.map((d) => {
                    const owner = whose(d.filingId);
                    return (
                      <tr>
                        <th scope="row">{owner ? <a href={owner.href}>{owner.name}</a> : d.filingId}</th>
                        <td><code>{d.rule.split('=').map((part, i) => (i === 0 ? part : <>=<wbr />{part}</>))}</code></td>
                        <td><code>{d.basis}</code></td>
                        <td class="num">{formatFigure(d.expected, d.unit)}</td>
                        <td class="num">{formatFigure(d.filed, d.unit)}</td>
                        <td class="num">{formatFigure(d.difference, d.unit, true)}</td>
                        <td>{drawFiguresInText(d.note)}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </>
        )}

        {s.title.startsWith('5.') && (
          <>
            <h3 id="not-comparable">Why two filers' shares are not directly comparable</h3>
            <p set:html={renderInline(paragraph.replace("**Why two filers' shares are not directly comparable.**", '').trim())} />
            {followOns.map((p) => <p set:html={renderInline(p)} />)}
          </>
        )}
      </>
    ))
  }

  <h2 id="health-centers">Health centers</h2>
  <p>
    The <a href={HC_HOME}>health centers pages</a> are built from files that federal agencies offer for download. A separate program saves each file unchanged, keeps only the fields on a written list for each part, and writes plain tables from what it kept. A field that is not on the list is dropped when the file is read, so nothing that names a person is kept. Each part has a check that rebuilds its tables from the kept files and compares them with the tables on file.
  </p>
  <p>
    A published value is printed as the agency published it. If ClinX calculates a number, the page says it was calculated by ClinX. Every page states the day of the file it shows and links to the agency's own file or page. A count is a count of rows in the agency's file on that day. No health center, area or state is ranked or compared with another.
  </p>
  <h3 id="health-centers-records">The records</h3>
  <p>
    The <a href={`${HC_HOME}records/`}>records</a> come from HRSA's yearly Uniform Data System workbooks for {recordYears}. ClinX keeps the rows of the listed health centers and the columns it knows. A value is the text HRSA published. HRSA's three marks are kept and shown in words: no entry, withheld because the number is small, and withheld to protect confidentiality. Text a health center typed into an "other" or "specify" column is not kept.
  </p>
  <p>
    ClinX has one rule of its own. In a column that counts patients, a published whole number from 1 to 15 is withheld, and the page says "Withheld by ClinX".{readTwice ? ' Each workbook is read a second time after LibreOffice converts it to a CSV file, and the two reads are compared cell by cell. They agree on every cell.' : ''}
  </p>
  <h3 id="health-centers-funding">The funding calendar</h3>
  <p>
    The <a href={FUNDING_HOME}>funding calendar</a> reads two public services. Grants.gov gives a record for each HRSA opportunity that is forecast or posted. The Federal Register gives the documents of the last twelve months that answer two questions: documents from HRSA that contain the phrase "health center", and documents from any agency that contain the phrase "federally qualified health center".
  </p>
  <p>
    A date is kept as the agency wrote it, and the day it names is stored without converting a time zone. A date that HRSA labels as estimated is marked Estimated everywhere. The name, phone number and email address of the agency contact on a Grants.gov record are not kept, and email addresses and phone numbers inside a free text are removed by pattern.
  </p>
  <h3 id="health-centers-areas">The shortage areas</h3>
  <p>
    The <a href={AREAS_PATH}>shortage areas</a> come from five files that HRSA publishes at data.hrsa.gov and refreshes daily: shortage areas for primary care, dental health and mental health, medically underserved areas and populations, and health center sites. ClinX saves each file with its address, the time it was retrieved and its SHA-256. HRSA publishes one row for each county, county subdivision or census tract of a designation. ClinX counts those rows and does not copy them.
  </p>
  <p>
    The telephone number, web address and billing numbers of a site, and the members of Congress named in the file, are dropped when the file is read. Each new copy is compared with the one before, and the differences are added to a table of changes. A date in HRSA's file may be earlier than the day a copy first shows the change. The files do not say why a designation changed.
  </p>

  <h2 id="fetching">How ClinX fetches public files</h2>
  <p>
    Small programs fetch many of the public files ClinX uses. Each of them introduces itself by name, <code>ClinX Open Data Reader (+https://clinx.org/methods/)</code>, with a link back to this page, so the people who run a site can see who is asking and why.
  </p>
  <p>
    A program asks for one file at a time. It saves each official file unchanged and records the address it came from, the file's size and its SHA-256, so anyone can check that a saved copy matches what the state published.
  </p>
  <p>
    If a site shows a robot check, the program stops there. It never answers the check and never works past it. Where a site turns programs away, a person opens the page and reads it.
  </p>
  </div>
</Base>
