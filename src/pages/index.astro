---
import '../styles/home.css';
import Base from '../layouts/Base.astro';
import { founderNode, siteNode } from '../lib/structured-data';
import Arrow from '../components/Arrow.astro';
import Draft from '../components/Draft.astro';
import { getBills } from '../lib/bills';
import { CLEANER_COPY, FILE_CHECK, HC_HOME, HC_NAME, REFERRALFINDERX_URL, numberWord, numberWordCap } from '../lib/site';
import { partDays } from '../lib/hc-hub';
import { REPORTING_GROUPS, statesInGroup, statesWith, tileMapSvg } from '../lib/states';

const live = statesWith('live');
const law = statesWith('law');
const kinds = REPORTING_GROUPS.map((g) => ({ ...g, states: statesInGroup(g.id) }));
const bills = getBills().bills.length;
const n = (x: number): string => x.toLocaleString('en-US');
const hcDays = partDays();
/** The tools, counted from their pages, so the figure moves when one is added. */
const tools = Object.keys(import.meta.glob('./tools/*/index.astro')).length;

/** How the work is done: the rules, each with the page that explains it. */
const ways = [
  {
    href: '/methods/',
    label: 'Methods',
    title: 'Every figure has a source',
    say: 'Each number is copied from a public record and links to that record. Every record is read twice and the two reads are compared. Nothing is corrected or estimated.',
  },
  {
    href: '/writing/check-a-page/',
    label: 'A guide',
    title: 'Your file stays with you',
    say: 'The tools run in your browser, on pages that cannot open a connection. A short guide shows three ways to test that for yourself.',
  },
  {
    href: '/about/#rules',
    label: 'About',
    title: 'No grades and no opinions',
    say: 'The site shows what was filed and how each measure is calculated. It does not grade a filer or say why a figure is what it is.',
  },
  {
    href: '/data/',
    label: 'Data',
    title: 'Open to reuse',
    say: 'The data is free under CC BY 4.0 and the code under MIT, so anyone can check a figure or build their own version.',
  },
];
---

<Base
  bleed
  title="ClinX: open healthcare data and tools for clinics"
  about={[siteNode(), founderNode()]}
  description="ClinX publishes open healthcare data and builds small tools a clinic of any size can use: the 340B Scorecard, state laws and bills, health center records, funding dates and shortage areas, and tools that keep your file on your computer."
>
  <section class="wrap hero hero-mission" aria-labelledby="hero-title">
    <div class="hero-say">
      <p class="kicker"><span class="dot" aria-hidden="true"></span>What ClinX is</p>
      <h1 id="hero-title">Healthcare tools and data, <span>within reach of every clinic.</span></h1>
      <p class="lede">
        In healthcare, the most capable tools are gated behind six-figure contracts, complex IT projects and compliance burdens, which puts them out of reach for most clinics. ClinX publishes open data and builds tools that a clinic of any size can pick up and use.
      </p>
      <div class="btn-row">
        <a class="btn" href="#work">See what ClinX does <Arrow /></a>
        <a class="btn ghost" href="/about/">Why it exists</a>
      </div>
      <p class="head-tag"><Draft /></p>
    </div>
    <ul class="hero-now" aria-label="ClinX today">
      <li><strong>{n(live.length)}</strong><span>states in the 340B Scorecard, every figure linked to its source</span></li>
      <li><strong>{n(bills)}</strong><span>340B bills followed in Congress and the states</span></li>
      <li><strong>{n(tools)}</strong><span>tools that run in your browser and keep your file on your computer</span></li>
      <li><strong>0</strong><span>cookies, trackers or sign-ins anywhere on the site</span></li>
    </ul>
  </section>

  <section id="work" class="band" aria-labelledby="work-title">
    <div class="wrap">
      <div class="band-head split-head">
        <h2 id="work-title">What ClinX does.</h2>
        <p class="lede">So far the data covers the federal 340B drug program and the federally funded health centers, and the tools work on the reports a clinic already has. Everything is free to use.</p>
      </div>
      <div class="work band-body">
        <article class="work-row" aria-labelledby="work-data">
          <div class="work-say">
            <p class="label">Open data</p>
            <h3 id="work-data">Public filings, in a form anyone can check.</h3>
            <p>
              States have begun requiring hospitals and health centers to report what they earn and spend under 340B. Some states post each filer's report and others publish a summary of their own, mostly as PDFs. ClinX copies the figures into open tables, line by line, and links each one to the page it came from.
            </p>
            <p>The site also follows the 340B laws each state has passed, the bills in Congress and the states, the federal notices, and the dates coming up.</p>
            <div class="btn-row">
              <a class="btn" href="/scorecard/">Open the scorecard <Arrow /></a>
              <a class="btn ghost" href="/data/">Get the data</a>
            </div>
          </div>
          <div class="work-show">
            <Fragment set:html={tileMapSvg('home-map')} />
            <ul class="legend">
              <li><span class="key live" aria-hidden="true"></span>In the scorecard</li>
              <li><span class="key law" aria-hidden="true"></span>Has a 340B reporting law</li>
              <li><span class="key" aria-hidden="true"></span>Neither yet</li>
            </ul>
            <p class="work-note">{numberWordCap(live.length)} states are in the scorecard, of {numberWord(live.length + law.length)} with a reporting law. A state is added once what it makes public has been copied and checked. What a state makes public differs:</p>
            <ul class="work-kinds">
              {
                kinds.map((k) => (
                  <li>
                    <a href={`/scorecard/#${k.id}`}>
                      <strong>{k.label}</strong>
                      <span>{k.states.map((s) => s.name).join(', ')}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </article>

        <article class="work-row" aria-labelledby="work-hc">
          <div class="work-say">
            <p class="label">{HC_NAME}</p>
            <h3 id="work-hc">Public information about federally funded health centers.</h3>
            <p>
              HRSA publishes what each health center reports every year and its files of shortage areas. HRSA and the Federal Register publish the funding dates. ClinX packages these files as pages and open files, and every page links to the file it came from.
            </p>
            <p>The records, the funding calendar and the shortage areas each have their own pages, and the files are free to download.</p>
            <div class="btn-row">
              <a class="btn" href={HC_HOME}>Open health centers <Arrow /></a>
              <a class="btn ghost" href="/data/#health-centers">Get the data</a>
            </div>
          </div>
          <div class="work-show">
            <ul class="work-tools alone">
              <li>
                <a href="/health-centers/records/">
                  <span><strong>Records</strong>What each health center reported to HRSA, year by year. HRSA refreshed its latest file on {hcDays.records}.</span>
                  <Arrow />
                </a>
              </li>
              <li>
                <a href="/health-centers/funding/">
                  <span><strong>Funding</strong>HRSA opportunities and Federal Register dates on one calendar, from the files of {hcDays.funding}.</span>
                  <Arrow />
                </a>
              </li>
              <li>
                <a href="/health-centers/shortage-areas/">
                  <span><strong>Shortage areas</strong>What HRSA designates and proposes to withdraw, state by state, from the files of {hcDays.areas}.</span>
                  <Arrow />
                </a>
              </li>
            </ul>
          </div>
        </article>

        <article class="work-row" aria-labelledby="work-tools">
          <div class="work-say">
            <p class="label">Tools</p>
            <h3 id="work-tools">Small tools for the files a clinic already has.</h3>
            <p>
              A clinic's reports hold patient details, which rules out most online tools. Each tool here runs inside your browser, on a page that cannot open a connection. The file you choose stays on your computer.
            </p>
            <p>Every tool comes with a plain account of how it is built, so you can check what it does before you trust it with a report.</p>
            <div class="btn-row">
              <a class="btn" href="/tools/">Open the tools <Arrow /></a>
              <a class="btn ghost" href="/writing/">Read how they are built</a>
            </div>
          </div>
          <div class="work-show">
            <p class="work-zero"><b>0</b><span>requests since you chose a file. Each tool counts the requests its page makes while it works, and shows you the count.</span></p>
            <ul class="work-tools">
              <li>
                <a href="/tools/cleaner-copy/">
                  <span><strong>{CLEANER_COPY}</strong>A copy of your report with randomized values in the columns you choose.</span>
                  <Arrow />
                </a>
              </li>
              <li>
                <a href="/tools/file-check/">
                  <span><strong>{FILE_CHECK}</strong>A list of what in your report will trip up a script or a pivot table.</span>
                  <Arrow />
                </a>
              </li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="ways-title">
    <div class="wrap">
      <div class="band-head split-head">
        <h2 id="ways-title">How the work is done.</h2>
        <p class="lede">ClinX holds itself to the same rules on every page. Each card links to the page that explains one of them.</p>
      </div>
      <div class="ways band-body">
        {
          ways.map((way) => (
            <a class="card" href={way.href}>
              <span class="label">{way.label}</span>
              <span>
                <strong>{way.title}</strong>
                <p>{way.say}</p>
              </span>
            </a>
          ))
        }
      </div>
      <a class="zeros" href="/privacy/">
        <span><b>0</b> cookies</span>
        <span><b>0</b> trackers</span>
        <span><b>0</b> sign-ins</span>
        <span><b>0</b> requests to other sites</span>
        <em>Privacy and security</em>
      </a>
    </div>
  </section>

  <section class="band" aria-labelledby="maker-title">
    <div class="wrap">
      <div class="maker">
        <h2 id="maker-title">Built by someone who does the work.</h2>
        <div class="maker-body">
          <p>
            ClinX is built by Will Berchtold, who works in community health in Rhode Island. It is where he publishes open healthcare data and tools made for the people who keep clinics running.
          </p>
          <div class="btn-row"><a class="btn ghost" href="/about/">About Will and ClinX</a></div>
        </div>
      </div>
      <div class="prod">
        <div class="prod-id">
          <img src="/brand/referralfinderx-mark.svg" alt="" width="72" height="72" />
          <div>
            <strong>ReferralFinderX</strong>
            <p>Also from ClinX: a directory of specialist offices for referral teams.</p>
          </div>
        </div>
        <a class="btn" href={REFERRALFINDERX_URL}>Visit ReferralFinderX <Arrow /></a>
      </div>
    </div>
  </section>
</Base>
