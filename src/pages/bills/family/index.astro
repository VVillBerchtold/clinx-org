---
/**
 * The bill family tree: state contract pharmacy bills and laws, each under the earlier text it shares the
 * most words with. The tree is built by scripts/bill-family.mjs from the official texts; this page tells it
 * on the site's tile map, with an arc to each text from its closest earlier text in another state, then as a
 * tree laid out by d3-hierarchy (src/lib/bill-family-pictures.ts). Both are drawn at build time, and every
 * link is printed with its shared words, so the page reads in full with scripts off. The month scrubber, the
 * scroll story, the readout cards and the folding branches are src/scripts/bill-family.ts.
 */
import '../../../styles/registry.css';
import '../../../styles/state-map.css';
import '../../../styles/bill-family.css';
import Base from '../../../layouts/Base.astro';
import FamilyNode from '../../../components/FamilyNode.astro';
import { formatDate } from '../../../lib/data';
import { BILLS_HOME, getBills } from '../../../lib/bills';
import { stateName } from '../../../lib/states';
import { FAMILY_HOME, childrenOf, fmt, fullName, getFamily, isLaw, memberHref, panelData, statusOf, travellingPassage, yearOf, type Member } from '../../../lib/bill-family';
import { familyMap, familyTreeSvg, markPassage } from '../../../lib/bill-family-pictures';

const data = getFamily();
const M = (id: string): Member => data.members.get(id)!;
const members = [...data.members.values()];
const big = data.families[0]!;
const bigM = big.members.map(M);
const small = data.families.slice(1);
const root = M(big.root);
const states = new Set(members.map((m) => m.state));
const acrossPairs = data.links.filter((l) => l.kind === 'across-states').length;
const laws = members.filter(isLaw).length;
const bigLaws = bigM.filter(isLaw).length;
const placed = members.filter((m) => m.parent).length;
const words = (n: number, one: string, many: string): string => `${fmt(n)} ${n === 1 ? one : many}`;
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const monthYear = (iso: string): string => `${MONTHS[Number(iso.slice(5, 7)) - 1]} ${iso.slice(0, 4)}`;
const names = (codes: Iterable<string>): string => {
  const list = [...new Set(codes)].map(stateName);
  return list.length < 2 ? list.join('') : `${list.slice(0, -1).join(', ')} and ${list.at(-1)}`;
};
const rootName = isLaw(root) && root.lawName ? `${stateName(root.state)}'s ${root.lawName}` : fullName(root);

// Bills about contract pharmacies listed in the bills table since the tree was last built: not compared yet.
const compared = new Set(members.map((m) => m.id));
const newer = getBills().bills.filter((b) => b.place !== 'US' && b.kinds.includes('contract-pharmacy') && !compared.has(b.billId));

// ---------- 1. The story: the family on the map, month by month ----------
const descendants = (id: string): string[] => [id, ...childrenOf(data, id).flatMap((k) => descendants(k.id))];
// The second source: the text, other than the earliest, with the most texts directly under it.
const hub = bigM.filter((m) => m.parent).sort((a, b) => childrenOf(data, b.id).length - childrenOf(data, a.id).length)[0]!;
const hubKids = childrenOf(data, hub.id);
const hubAcross = hubKids.filter((k) => k.state !== hub.state);
const lastDay = bigM.map((m) => m.order).sort().at(-1)!;
const yearAfter = `${Number(root.order.slice(0, 4)) + 1}-12-31`;
const inYear1 = bigM.filter((m) => m.order > root.order && m.order <= yearAfter);
const waveTo = `${lastDay.slice(0, 4) > '2025' ? '2025' : lastDay.slice(0, 4)}-03-31`;
const wave = bigM.filter((m) => m.order > yearAfter && m.order <= waveTo);
const after = bigM.filter((m) => m.order > waveTo);
const steps = [
  {
    month: root.order.slice(0, 7),
    label: monthYear(root.order),
    text: `${rootName} is ${isLaw(root) ? 'law' : statusOf(root).toLowerCase()}. It is the earliest text in this family: every text drawn here shares a passage of ${data.rules.minLongest} words or more with it, or with a text that does.`,
  },
  {
    month: yearAfter.slice(0, 7),
    label: `To ${yearAfter.slice(0, 4)}`,
    text: `${words(inYear1.length, 'text follows', 'texts follow')} in ${yearAfter.slice(0, 4)}, ${inYear1.filter(isLaw).length} of them law: ${names(inYear1.map((m) => m.state))}. Each sits under ${stateName(root.state)}'s text, the earlier one it shares the most words with.`,
  },
  {
    month: waveTo.slice(0, 7),
    label: `Early ${waveTo.slice(0, 4)}`,
    text: `The ${waveTo.slice(0, 4)} sessions open. In three months, ${words(wave.length, 'text', 'texts')} in ${new Set(wave.map((m) => m.state)).size} states join the family. ${fmt(wave.filter((m) => m.parent === root.id).length)} sit straight under ${stateName(root.state)}; the rest under a text filed weeks before.`,
  },
  {
    month: lastDay.slice(0, 7),
    label: `A second source`,
    focus: descendants(hub.id).join(' '),
    text: `${fullName(hub)}, filed in ${monthYear(hub.order)}, becomes the closest wording for ${words(hubKids.length, 'later text', 'later texts')}, ${hubAcross.length} of them in ${names(hubAcross.map((m) => m.state))}.`,
  },
  {
    month: lastDay.slice(0, 7),
    label: 'Today',
    text: `${fmt(big.members.length)} texts in ${big.states.length} states, ${bigLaws} of them law. The newest is ${fullName(M(bigM.filter((m) => m.order === lastDay).at(-1)!.id))}, from ${monthYear(lastDay)}. ${words(after.length, 'text', 'texts')} came after the spring of ${waveTo.slice(0, 4)}.`,
  },
];
const P = travellingPassage(data, big);
const map = familyMap(data, big, {
  id: 'bf-map',
  title: `The largest family on the map: ${big.members.length} bills and laws in ${big.states.length} states, ${yearOf(root)} to ${lastDay.slice(0, 4)}`,
  desc: `A filled state has a text in the family that is law; an outlined state has bills only. An arc runs to each text from the earlier text in another state it shares the most words with, thicker the longer the passage they share. The list in part 3 gives every link with its words.`,
  mark: P.words,
});
const mapJson = JSON.stringify({ months: map.months, cards: map.cards });
// ---------- 2. The words that travel ----------
const firstHolder = [...P.links].sort((a, b) => M(a.b).order.localeCompare(M(b.b).order))[0];
const quoteParts = markPassage(firstHolder?.longestPassage ?? '', P.words);
const travelMap = familyMap(data, big, {
  id: 'bf-travel',
  title: `The ${P.links.length} links whose longest shared passage holds these words, in ${P.states.length} states`,
  desc: `The states with a text on these links, filled where one of those texts is law. An arc runs to each text from the earlier text in another state it shares the words with.`,
  only: P.texts,
  class: 'fm-still',
});

// ---------- 3. Every text in the family ----------
const treeTitle = `Every text in the largest family, ${yearOf(root)} to ${lastDay.slice(0, 4)}`;
const treeDesc = `${big.members.length} bills and laws in ${big.states.length} states. Each text sits under the earlier text it shares the most words with, the earliest on the left; a filled dot is law; an orange line crosses a state line, thicker the longer the passage shared. Each text leads to its place in the list after the picture, which prints the words.`;
const treeWide = familyTreeSvg(data, big, { id: 'bf-tree', title: treeTitle, desc: treeDesc, layout: 'tidy', fold: true });
const treeNarrow = familyTreeSvg(data, big, { id: 'bf-tree-p', title: treeTitle, desc: treeDesc, layout: 'indent', fold: true });
const panel = panelData(data, big);
const chips = big.states
  .map((s) => ({ code: s, name: stateName(s), n: bigM.filter((m) => m.state === s).length }))
  .sort((a, b) => a.name.localeCompare(b.name));

// ---------- 4. Families that stay home ----------
const smallCards = small.map((f) => {
  const fm = f.members.map(M);
  const y = [...new Set(fm.map(yearOf))].sort();
  return {
    f,
    title: f.states.map(stateName).join(' and '),
    sub: `${words(fm.length, 'text', 'texts')}, ${y.length > 1 ? `${y[0]} to ${y.at(-1)}` : y[0]}${fm.some(isLaw) ? `, ${words(fm.filter(isLaw).length, 'law', 'laws')}` : ''}`,
    svg: familyTreeSvg(data, f, {
      id: `bf-f${f.family}`,
      layout: 'indent',
      title: `${f.states.map(stateName).join(' and ')}: ${fm.length} texts`,
      desc: `Each text sits under the earlier text it shares the most words with; a filled dot is law.`,
    }),
  };
});
const homeOnly = small.filter((f) => f.states.length === 1).length;

const parts = [
  { id: 'spread', label: 'How the wording spread' },
  { id: 'words', label: 'The words that travel' },
  { id: 'family', label: 'Every text in the family' },
  { id: 'home', label: 'Families that stay home' },
  { id: 'how', label: 'How the links are found' },
];
---

<Base
  title="The 340B bill family tree"
  bleed
  crumbs={[{ name: 'Bills', path: BILLS_HOME }, { name: 'Family tree', path: FAMILY_HOME }]}
  description={`${fmt(members.length)} state bills and laws on 340B contract pharmacies, compared word for word. ${fmt(big.members.length)} in ${big.states.length} states share wording whose earliest text here is ${fullName(root)}. Every link shows the words.`}
>
  <header class="rx-head">
    <div class="wrap">
      <p class="rx-kicker"><span class="dot" aria-hidden="true"></span>340B <span aria-hidden="true">/</span> Bills <span aria-hidden="true">/</span> Family tree</p>
      <h1>{big.states.length} states, one family of words</h1>
      <p class="rx-lede">
        State bills on 340B contract pharmacies share whole passages, word for word. Compared side by side, {fmt(big.members.length)} of them form one family, and the earliest is {rootName}.
      </p>
      <div class="rx-figures">
        <div class="rx-hero-fig">
          <p class="rx-hero-value">{big.states.length}</p>
          <p class="rx-hero-label">states hold a bill or law in the family, {bigLaws} of them now law</p>
        </div>
        <dl class="rx-stats">
          <div><dt>Bills and laws compared</dt><dd>{fmt(members.length)}</dd></div>
          <div><dt>In the largest family</dt><dd>{fmt(big.members.length)}</dd></div>
          <div><dt>Pairs sharing a passage across a state line</dt><dd>{fmt(acrossPairs)}</dd></div>
          <div><dt>Earliest text in it</dt><dd>{yearOf(root)}</dd></div>
        </dl>
      </div>
    </div>
  </header>

  <nav class="rx-parts wrap" aria-label="Parts of this page">
    <ol>{parts.map((p, i) => <li><a href={`#${p.id}`}><span class="rx-part-n">{i + 1}</span>{p.label}</a></li>)}</ol>
  </nav>

  <section class="rx-section" id="spread" aria-labelledby="spread-h">
    <div class="wrap">
      <p class="rx-step">1</p>
      <h2 id="spread-h">How the wording spread</h2>
      <p class="rx-text">
        A state fills when a text in the family becomes law there, and is outlined while it has only bills. Each arc runs to a text from the earlier text in another state it shares the most words with: the thicker the arc, the longer the passage they share.
      </p>
      <div class="rx-story rx-story-map bf-mapstory" data-story data-fm data-fm-json={mapJson}>
        <div class="rx-story-pin">
          <div class="rx-lapse" hidden data-lapse-controls>
            <button type="button" class="rx-play" data-play aria-label={`Play the family from ${monthYear(map.months[0]!)}`}><span class="rx-play-icon" aria-hidden="true"></span><span data-play-label>Play</span></button>
            <label class="rx-range">
              <span class="visually-hidden">Month shown on the map</span>
              <span class="rx-range-end" aria-hidden="true">{map.months[0]!.slice(0, 4)}</span>
              <input type="range" min="0" step="1" data-year-range />
              <span class="rx-range-end" aria-hidden="true">{map.months.at(-1)!.slice(0, 4)}</span>
            </label>
          </div>
          <div class="bf-mapbox">
            <figure class="rx-map bf-map">
              <p class="rx-map-year"><span class="bf-when" data-fm-when>Today</span> <span data-fm-count>{fmt(big.members.length)} texts, {big.states.length} states, {new Set(bigM.filter(isLaw).map((m) => m.state)).size} with a law</span></p>
              <Fragment set:html={map.svg} />
            </figure>
            <aside class="bf-card bf-scard" hidden data-fm-card aria-live="polite">
              <p class="bf-c-kicker" data-fm-kicker></p>
              <p class="bf-c-name" data-fm-name></p>
              <ol class="bf-s-texts" data-fm-texts></ol>
              <p class="bf-c-go"><button type="button" class="bf-c-close" data-fm-close>Close</button></p>
            </aside>
          </div>
          <ul class="rx-legend bf-key">
            <li><span class="bf-k-tile has" aria-hidden="true"></span>A text is law</li>
            <li><span class="bf-k-tile" aria-hidden="true"></span>Bills only</li>
            <li><span class="bf-k-arc" aria-hidden="true"></span>Shares a passage with an earlier text there</li>
            <li><span class="bf-k-w" aria-hidden="true"><span></span><span></span><span></span></span>Thicker: a longer passage</li>
          </ul>
        </div>
        <ol class="rx-story-steps">
          {steps.map((s) => (
            <li class="rx-story-step" data-month={s.month} data-focus={s.focus}>
              <p class="rx-story-year">{s.label}</p>
              <p class="rx-story-text">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
      <p class="rx-small bf-note">An arc joins a text to the earlier text it shares the most words with. That is the closest wording in this record; it does not say who drafted either text or which was copied. No bill or law here names a model bill. Point at a state, or select it, for its texts and the words they share.</p>
    </div>
  </section>

  <section class="rx-section rx-alt" id="words" aria-labelledby="words-h">
    <div class="wrap">
      <p class="rx-step">2</p>
      <h2 id="words-h">The words that travel</h2>
      <p class="rx-text">
        One clause turns up again and again: the one on data a drug maker may not require as a condition for the acquisition or delivery of a 340B drug. On {P.links.length} of the family&rsquo;s links, the longest passage the two texts share holds the same words, in {P.states.length} states.
      </p>
      <div class="bf-travel">
        <figure class="bf-quote">
          <blockquote>
            <p>&hellip;{quoteParts[0]} <mark>{quoteParts[1]}</mark> {quoteParts[2]}&hellip;</p>
          </blockquote>
          {firstHolder && <figcaption>As {fullName(M(firstHolder.a))} prints it. Marked: the words every one of the {P.links.length} passages holds.</figcaption>}
          <ul class="bf-chips bf-chips-static" aria-label="States with a text on these links">
            {P.states.map((s) => <li><span class="bf-chip">{stateName(s)}</span></li>)}
          </ul>
        </figure>
        <figure class="rx-map bf-travel-fig">
          <Fragment set:html={travelMap.svg} />
          <figcaption>The {P.states.length} states with a text on these links, and the arcs between them.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="rx-section" id="family" aria-labelledby="family-h">
    <div class="wrap">
      <p class="rx-step">3</p>
      <h2 id="family-h">Every text in the family</h2>
      <p class="rx-text">
        The same {fmt(big.members.length)} texts as a tree, each under the earlier text it shares the most words with. Fold a branch with its button. Point at a text, or select it, to read the passage it shares with the one above it.
      </p>
      <div class="bf-explore" data-bf data-bf-json={panel}>
        <div class="bf-explore-main">
          <ul class="bf-chips" hidden data-bf-chips aria-label="Light a state's texts">
            {chips.map((c) => (
              <li><button type="button" class="bf-chip" data-state={c.code} aria-pressed="false">{c.name} <span>{c.n}</span></button></li>
            ))}
          </ul>
          <figure class="rx-figure bf-explore-fig">
            <Fragment set:html={treeWide} />
            <Fragment set:html={treeNarrow} />
          </figure>
          <ul class="rx-legend bf-key bf-tree-key">
            <li><span class="bf-k-dot law" aria-hidden="true"></span>Law, or became law</li>
            <li><span class="bf-k-dot" aria-hidden="true"></span>Bill</li>
            <li><span class="bf-k-line across" aria-hidden="true"></span>Shares text across a state line</li>
            <li><span class="bf-k-line" aria-hidden="true"></span>Same state</li>
          </ul>
        <aside class="bf-card" hidden data-bf-panel aria-live="polite">
          <div data-bf-card hidden>
            <p class="bf-c-kicker"><span data-f="state"></span> · <span data-f="year"></span> · <span data-f="status"></span></p>
            <p class="bf-c-name" data-f="name"></p>
            <p class="bf-c-title" data-f="title"></p>
            <div data-bf-link>
              <p class="bf-c-with">Closest earlier text: <strong data-f="parent"></strong> <span class="bf-c-kind" data-f="kind"></span></p>
              <dl class="bf-c-figs">
                <div><dt>Words shared</dt><dd data-f="shared"></dd></div>
                <div><dt>Longest run</dt><dd data-f="longest"></dd></div>
              </dl>
              <svg class="bf-c-meter" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="bg" x="0" y="0" width="100" height="6"/><rect class="fg" data-f-meter x="0" y="0" width="0" height="6"/></svg>
              <blockquote class="bf-c-quote" data-f="passage"></blockquote>
            </div>
            <p class="bf-c-root" data-bf-root>The earliest text in this family.</p>
            <p class="bf-c-go"><a data-f-href href="#">Open its page</a> <span data-f="kids"></span> <button type="button" class="bf-c-close" data-bf-close>Close</button></p>
          </div>
        </aside>
        </div>
      </div>

      <details class="rx-table bf-list">
        <summary>Every link, with the words</summary>
        <p class="rx-small">The same family as a list. Each line names the text it sits under and how many words they share; open it for the longest passage they share.</p>
        <ol class="bf-outline">
          <FamilyNode data={data} id={big.root} />
        </ol>
      </details>
    </div>
  </section>

  <section class="rx-section rx-alt" id="home" aria-labelledby="home-h">
    <div class="wrap">
      <p class="rx-step">4</p>
      <h2 id="home-h">Families that stay home</h2>
      <p class="rx-text">
        {small.length} smaller families, {homeOnly} of them inside one state: a bill filed in both chambers, carried into the next year, or filed again. {fmt(data.alone.length)} texts have no close relative at all.
      </p>
      <ul class="bf-multiples">
        {smallCards.map((c) => (
          <li>
            <p class="sm-name">{c.title} <span>{c.sub}</span></p>
            <Fragment set:html={c.svg} />
            <details class="bf-mini-list">
              <summary>The links</summary>
              <ol class="bf-outline compact"><FamilyNode data={data} id={c.f.root} /></ol>
            </details>
          </li>
        ))}
      </ul>
      <h3 class="rx-sub-h">No close relative</h3>
      <p class="rx-small">These share no passage of {data.rules.minLongest} words with an earlier text, and no later text sits under them.</p>
      <ul class="bf-alone">
        {data.alone.map((id) => {
          const m = M(id);
          return (
            <li id={`o-${m.id}`}>
              <a href={memberHref(m)}><strong>{m.state}</strong> {m.type === 'bill' ? m.number : m.lawName}</a>
              <span>{yearOf(m)} · {statusOf(m)}</span>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="rx-section" id="how" aria-labelledby="how-h">
    <div class="wrap">
      <p class="rx-step">5</p>
      <h2 id="how-h">How the links are found</h2>
      <ol class="bf-how">
        <li><strong>The official texts.</strong><span>Every state bill on contract pharmacies in the <a href={BILLS_HOME}>bills table</a>, in the newest text its legislature published, and every state contract pharmacy law in the <a href="/laws/contract-pharmacy/">laws table</a>, in its enacted text. {fmt(members.length)} texts in {states.size} states, {fmt(laws)} of them law.</span></li>
        <li><strong>Word for word.</strong><span>A shared passage is a run of at least {data.rules.minRun} words in the same order in both texts. It counts only if it names 340B, a drug, a pharmacy, a manufacturer or a covered entity, so the common frame of any bill (dates, severability, definitions of health records) is left out.</span></li>
        <li><strong>Enough to link.</strong><span>Two texts are linked when they share {data.rules.minShared} words or more and one passage runs {data.rules.minLongest} words or more. A bill with the same number listed under two years is linked as one bill.</span></li>
        <li><strong>Where a text sits.</strong><span>Under the earlier text, by the day it was introduced or became law, that it shares the most words with. That is the closest wording in this record. It does not say who drafted either text or which was copied.</span></li>
      </ol>
      <ul class="rx-limits bf-limits">
        <li>No bill or law here names a model bill it was drawn from, so none is shown.</li>
        <li>The texts compared are the newest each legislature published. A bill amended after it was filed may hold words from a text dated later than its own start.</li>
        {newer.length > 0 && <li>{words(newer.length, 'bill', 'bills')} on contract pharmacies joined the bills table after the texts were compared on {formatDate(data.built)}, and are not in the tree yet: {newer.map((b) => `${stateName(b.place)} ${b.bill}`).join(', ')}.</li>}
      </ul>
      <div class="btn-row">
        <a class="btn" href="/data/340b-bill-links.csv" download>Every link as a table (CSV)</a>
        <a class="btn ghost" href={BILLS_HOME}>All 340B bills</a>
      </div>
    </div>
  </section>

  <footer class="rx-source">
    <div class="wrap rx-measure">
      <p>Sources: the official bill texts each state legislature publishes, as saved by the ClinX bills table (retrieved {formatDate(data.billsRetrieved)}), and the enacted texts saved by the ClinX laws table. Compared on {formatDate(data.built)}. {fmt(placed)} of {fmt(members.length)} texts sit under an earlier one.</p>
    </div>
  </footer>
</Base>

<script>
  import '../../../scripts/bill-family';
</script>
