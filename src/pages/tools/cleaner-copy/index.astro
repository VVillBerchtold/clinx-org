---
import '../../../styles/pages.css';
import '../../../styles/cleaner-copy.css';
import Base from '../../../layouts/Base.astro';
import Arrow from '../../../components/Arrow.astro';
import PageHead from '../../../components/PageHead.astro';
import { CLEANER_COPY, CLEANER_COPY_ARTICLE_TITLE } from '../../../lib/site';

const STEPS = ['Before you start', 'Choose a file', 'Choose columns', 'Save the copy'];
---

<Base
  title={`${CLEANER_COPY}: a randomized copy of your report`}
  crumbs={[
    { name: 'Tools', path: '/tools/' },
    { name: CLEANER_COPY, path: '/tools/cleaner-copy/' },
  ]}
  description="Give it a workbook or a CSV file and get back a copy with the same sheets, headings and formulas, and randomized values in the columns you choose. It runs in your browser."
>
  <svg class="cc-sprite" width="0" height="0" aria-hidden="true" focusable="false">
    <symbol id="cc-i-check" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m4 10.5 4 4 8-9"></path></symbol>
    <symbol id="cc-i-right" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h12M11 5l5 5-5 5"></path></symbol>
    <symbol id="cc-i-left" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 10H4M9 5l-5 5 5 5"></path></symbol>
    <symbol id="cc-i-save" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3v10M5.5 9l4.5 4.5L14.5 9M4 16.5h12"></path></symbol>
    <symbol id="cc-i-file" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2.5h5.5l4 4V16a1.5 1.5 0 0 1-1.5 1.5H6A1.5 1.5 0 0 1 4.5 16V4A1.5 1.5 0 0 1 6 2.5ZM11.5 2.5v4h4M7.5 10.5h5M7.5 13.5h5"></path></symbol>
    <symbol id="cc-i-screen" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4.5h14v9H3zM7 17h6M10 13.5V17"></path></symbol>
    <symbol id="cc-i-columns" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 4h13v12h-13zM8 4v12M12.5 4v12"></path></symbol>
    <symbol id="cc-i-search" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3.5a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11ZM13.2 13.2 17 17"></path></symbol>
    <symbol id="cc-i-alert" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3.2 17.5 16h-15L10 3.2ZM10 8.5V12M10 14.3v.2"></path></symbol>
    <symbol id="cc-i-info" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2.5a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15ZM10 9.2V14M10 6.3v.2"></path></symbol>
    <symbol id="cc-i-copy" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h9.5v9.5H7zM4 13V3.5h9.5"></path></symbol>
    <symbol id="cc-i-again" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 10a6 6 0 1 1-1.8-4.3M16 3.8v3.7h-3.7"></path></symbol>
  </svg>

  <PageHead wide title={CLEANER_COPY} trail={[{ label: 'Tools', href: '/tools/' }, { label: CLEANER_COPY }]}>
    <p class="lede">Give it a report. Get back a copy with the same sheets, headings and formulas, and randomized values in the columns you choose.</p>
    <ul class="cc-promises">
      <li><svg width="16" height="16" aria-hidden="true" focusable="false"><use href="#cc-i-check"></use></svg>Runs in your browser</li>
      <li><svg width="16" height="16" aria-hidden="true" focusable="false"><use href="#cc-i-check"></use></svg>Opens no connection</li>
      <li><svg width="16" height="16" aria-hidden="true" focusable="false"><use href="#cc-i-check"></use></svg>Keeps nothing afterwards</li>
    </ul>
  </PageHead>

  <p id="cc-off" class="panel cc-off">This tool works in your browser, so it needs scripts turned on. <a href="/writing/cleaner-copy/">The article</a> explains what it does.</p>

  <div id="cc" class="cc" hidden>
    <div class="cc-rail">
      <ol id="cc-steps" class="cc-steps">
        {
          STEPS.map((label, i) => (
            <li>
              <button type="button" class="cc-stepper" data-go={i + 1} disabled>
                <span class="cc-num" aria-hidden="true">
                  <span>{i + 1}</span>
                  <svg width="16" height="16" focusable="false">
                    <use href="#cc-i-check" />
                  </svg>
                </span>
                <span class="cc-step-say">
                  <span class="cc-step-count">Step {i + 1}</span>
                  <span class="cc-step-name">{label}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ol>
      <p class="cc-wire" id="cc-wire"><span class="cc-wire-dot" aria-hidden="true"></span><span id="cc-wire-say">No connection can be opened from this page</span></p>
    </div>
    <p id="cc-where" class="cc-where" aria-hidden="true"></p>

    <div class="cc-body">
      <!-- Step 1 -->
      <section id="cc-step-1" class="cc-step" aria-labelledby="cc-h-1">
        <header class="cc-step-head">
          <h2 id="cc-h-1" tabindex="-1">Before you start</h2>
          <p>Three things to know about how this works.</p>
        </header>
        <ul class="cc-trio">
          <li>
            <span class="cc-badge"><svg width="22" height="22" aria-hidden="true" focusable="false"><use href="#cc-i-screen"></use></svg></span>
            <h3>The file stays with you</h3>
            <p>The page reads the file inside your browser. It cannot open a connection, so it has no way to send the file anywhere.</p>
          </li>
          <li>
            <span class="cc-badge"><svg width="22" height="22" aria-hidden="true" focusable="false"><use href="#cc-i-columns"></use></svg></span>
            <h3>You choose the columns</h3>
            <p>You see every column first. Each value is replaced with a random one of the same shape, unless you leave its column alone.</p>
          </li>
          <li>
            <span class="cc-badge"><svg width="22" height="22" aria-hidden="true" focusable="false"><use href="#cc-i-search"></use></svg></span>
            <h3>The copy gets checked</h3>
            <p>When the copy is made, the page searches it for every text it replaced and tells you what it found.</p>
          </li>
        </ul>
        <div class="cc-limits">
          <h3>What to keep in mind</h3>
          <ul>
            <li>A column you leave alone stays exactly as it is. A notes column can say anything about anyone, so let it be replaced.</li>
            <li>Totals and trends in the copy are randomized along with the values. Use the copy to build a script or a layout, and take your numbers from the real report.</li>
            <li>The page tells you what it replaced and what it could not check. Whether a copy may leave your organization is for whoever is responsible for that to decide.</li>
          </ul>
        </div>
        <label class="cc-agree" for="cc-agree">
          <input id="cc-agree" type="checkbox" />
          <span class="cc-tick" aria-hidden="true"><svg width="16" height="16" focusable="false"><use href="#cc-i-check"></use></svg></span>
          <span>I have read this, and I will look through the copy before I share it.</span>
        </label>
      </section>

      <!-- Step 2 -->
      <section id="cc-step-2" class="cc-step" aria-labelledby="cc-h-2" hidden>
        <header class="cc-step-head">
          <h2 id="cc-h-2" tabindex="-1">Choose a file</h2>
          <p>An Excel workbook (.xlsx or .xlsm) or a CSV file. Nothing is changed in this step.</p>
        </header>
        <div id="cc-drop" class="cc-drop">
          <span class="cc-badge big"><svg width="30" height="30" aria-hidden="true" focusable="false"><use href="#cc-i-file"></use></svg></span>
          <p class="cc-drop-say">Drop a workbook or a CSV file here</p>
          <div class="btn-row">
            <input id="cc-file" class="visually-hidden" type="file" accept=".xlsx,.xlsm,.csv,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" aria-describedby="cc-drop-help" />
            <label for="cc-file" class="btn accent">Choose a file</label>
            <button id="cc-sample" class="btn ghost" type="button">Try the sample report</button>
          </div>
          <p id="cc-drop-help" class="small muted">The sample report is a small clinic workbook with invented patients. It is a good first run.</p>
        </div>
        <p id="cc-problem" class="cc-problem" role="alert" hidden></p>
        <div id="cc-loaded" class="cc-loaded" hidden>
          <div class="cc-filecard">
            <span class="cc-badge"><svg width="22" height="22" aria-hidden="true" focusable="false"><use href="#cc-i-file"></use></svg></span>
            <div class="cc-filecard-say">
              <strong id="cc-file-name"></strong>
              <span id="cc-file-meta" class="small muted"></span>
            </div>
            <button id="cc-other" class="cc-link" type="button">Choose another file</button>
          </div>
          <dl id="cc-file-stats" class="cc-stats"></dl>
          <div class="cc-finds">
            <h3 id="cc-finds-h"></h3>
            <p id="cc-finds-say" class="small muted"></p>
            <ul id="cc-finds-list" class="cc-find-list"></ul>
          </div>
        </div>
      </section>

      <!-- Step 3 -->
      <section id="cc-step-3" class="cc-step" aria-labelledby="cc-h-3" hidden>
        <header class="cc-step-head">
          <h2 id="cc-h-3" tabindex="-1">Choose columns</h2>
          <p>Every column gets randomized values unless you choose otherwise. A column can also be coded, or left exactly as it is.</p>
        </header>
        <div class="cc-chooser">
          <nav class="cc-sheets" aria-label="Sheets in this file">
            <h3>Sheets</h3>
            <ul id="cc-sheet-list"></ul>
          </nav>
          <div class="cc-sheet" id="cc-sheet"></div>
        </div>
        <div id="cc-options" class="cc-options" hidden></div>
      </section>

      <!-- Step 4 -->
      <section id="cc-step-4" class="cc-step" aria-labelledby="cc-h-4" hidden>
        <header class="cc-step-head">
          <h2 id="cc-h-4" tabindex="-1">Save the copy</h2>
          <p id="cc-result-say">The copy is being made.</p>
        </header>
        <div id="cc-working" class="cc-working">
          <progress aria-label="Making the copy"></progress>
          <p>Making the copy, then searching it for what was replaced.</p>
        </div>
        <div id="cc-result" class="cc-result" hidden></div>
      </section>
    </div>

    <div class="cc-foot">
      <button id="cc-back" class="btn ghost" type="button"><svg width="18" height="18" aria-hidden="true" focusable="false"><use href="#cc-i-left"></use></svg>Back</button>
      <p id="cc-tally" class="cc-tally" aria-live="polite"></p>
      <button id="cc-next" class="btn accent" type="button" disabled><span id="cc-next-say">Continue</span><svg width="18" height="18" aria-hidden="true" focusable="false"><use href="#cc-i-right"></use></svg></button>
    </div>
    <p id="cc-live" class="visually-hidden" role="status" aria-live="polite"></p>
  </div>

  <section class="cc-about" aria-labelledby="cc-about-h">
    <h2 id="cc-about-h">What a copy is for</h2>
    <ul class="cc-uses">
      <li>
        <h3>Help from an AI assistant</h3>
        <p>An assistant can write the Excel script or the report layout from a copy that has the same shape as your report.</p>
      </li>
      <li>
        <h3>Testing a script or a bot</h3>
        <p>Build and test against the copy. Then run the finished script on the real report, on your own computer.</p>
      </li>
      <li>
        <h3>Seeing what a file holds</h3>
        <p>The second step lists hidden sheets, macros, saved connections and built-in queries in plain words.</p>
      </li>
    </ul>
    <a class="cc-read" href="/writing/cleaner-copy/">
      <span>
        <span class="label">Article</span>
        <strong>{CLEANER_COPY_ARTICLE_TITLE}</strong>
        <span class="muted">How the tool works, what it checks, and where it stops helping.</span>
      </span>
      <Arrow />
    </a>
  </section>

  <script>
    import '../../../scripts/cleaner-copy/main';
  </script>
</Base>
