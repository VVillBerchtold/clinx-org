---
import '../../styles/pages.css';
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import Draft from '../../components/Draft.astro';
import PageHead from '../../components/PageHead.astro';
import { REFERRALFINDERX_URL } from '../../lib/site';
---

<Base title="Products: ReferralFinderX" crumbs={[{ name: 'Products', path: '/products/' }]} description="ReferralFinderX, a directory of specialist offices for referral teams, from the maker of ClinX. It is kept apart from the open data and the tools on this site.">
  <PageHead title="Products" trail={[{ label: 'ClinX' }]}>
    <p class="lede">A product from the person who builds ClinX. The open data and the tools on this site are free and stand apart from it.</p>
  </PageHead>

  <section class="product" aria-labelledby="referralfinderx">
    <div class="product-say">
      <img src="/brand/referralfinderx-mark.svg" alt="" width="88" height="88" />
      <h2 id="referralfinderx">ReferralFinderX</h2>
      <p>A directory of specialist offices for referral teams. Built from the referral desk up.</p>
      <a class="btn" href={REFERRALFINDERX_URL}>Visit ReferralFinderX <Arrow /></a>
    </div>
    <dl class="product-facts">
      <div>
        <dt>Search by</dt>
        <dd>
          <ul class="chips">
            <li>Location</li>
            <li>Specialty</li>
            <li>Age</li>
            <li>Insurance</li>
          </ul>
        </dd>
      </div>
      <div>
        <dt>Get what a referral needs</dt>
        <dd>
          <ul class="chips">
            <li>Fax</li>
            <li>Phone</li>
            <li>Address</li>
            <li>Taking new patients</li>
          </ul>
        </dd>
      </div>
      <div>
        <dt>Every detail</dt>
        <dd>
          <ul class="chips">
            <li>Dated</li>
          </ul>
        </dd>
      </div>
    </dl>
  </section>

  <div class="after-product">
    <section class="split" aria-labelledby="who">
      <h2 id="who">Who it is for</h2>
      <div class="split-body">
        <p class="head-tag"><Draft /></p>
        <p>
          ReferralFinderX is for the referral teams at clinics and community health centers. Coordinators search for a specialist office, then get the details a referral needs. Each detail is dated, so the team can see how current it is.
        </p>
        <p>It is based in Rhode Island.</p>
      </div>
    </section>

    <section class="split" aria-labelledby="apart">
      <h2 id="apart">Kept apart from the open data and the tools</h2>
      <div class="split-body">
        <p>
          The <a href="/data/">open data</a> and the <a href="/tools/">tools</a> on this site are free to use. They do not depend on ReferralFinderX, and nothing on those pages is there to sell it.
        </p>
      </div>
    </section>
  </div>
</Base>
