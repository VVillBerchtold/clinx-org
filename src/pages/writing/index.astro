---
import '../../styles/article.css';
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import Draft from '../../components/Draft.astro';
import PageHead from '../../components/PageHead.astro';
import { ARTICLE_TITLE, CHECKING_ARTICLE_TITLE, CLEANER_COPY, CLEANER_COPY_ARTICLE_TITLE, RENTING_ARTICLE_TITLE, SCHEDULE_DESIGNER, SCHEDULE_DESIGNER_ARTICLE_TITLE, WHOSE_ARTICLE_TITLE, WORKBOOK_ARTICLE_TITLE } from '../../lib/site';

/** What a piece of writing ends with: the tool or demo its last button opens. */
const cleanerCopy = { href: '/tools/cleaner-copy/', kind: 'Tool', name: CLEANER_COPY };
const scheduleDesigner = { href: '/tools/schedule-designer/', kind: 'Tool', name: SCHEDULE_DESIGNER };
const registry = { href: '/registry/', kind: 'Data', name: 'Registry history' };
const totalsDemo = { href: '/writing/no-phi/demo/', kind: 'Demo', name: 'Totals from a file' };

/** Every piece, newest first. Each one is drawn as the same card. */
const pieces = [
  {
    href: '/writing/whose-pharmacies/',
    kind: 'Analysis',
    minutes: 7,
    title: WHOSE_ARTICLE_TITLE,
    say: 'The federal 340B registry shows the safety net\'s contract pharmacies moving to pharmacies owned by the largest insurers and PBMs.',
    goesWith: registry,
  },
  {
    href: '/writing/saved-as-a-workbook/',
    kind: 'Article',
    minutes: 4,
    title: SCHEDULE_DESIGNER_ARTICLE_TITLE,
    say: 'The Schedule Designer keeps no account and sends nothing, so a saved schedule is an Excel workbook on your own computer.',
    goesWith: scheduleDesigner,
  },
  {
    href: '/writing/what-are-we-renting/',
    kind: 'Essay',
    minutes: 6,
    title: RENTING_ARTICLE_TITLE,
    say: 'Why clinic software became something to rent, what has changed, and what is still worth paying for.',
    goesWith: cleanerCopy,
  },
  {
    href: '/writing/cleaner-copy/',
    kind: 'Article',
    minutes: 5,
    title: CLEANER_COPY_ARTICLE_TITLE,
    say: 'A copy of your workbook with the same shape and randomized values, so an assistant can help with the script and never see a patient.',
    goesWith: cleanerCopy,
  },
  {
    href: '/writing/inside-a-workbook/',
    kind: 'Article',
    minutes: 4,
    title: WORKBOOK_ARTICLE_TITLE,
    say: 'Pivot tables, saved formula answers, links, filters and hidden sheets can hold data that is no longer on the screen.',
    goesWith: cleanerCopy,
  },
  {
    href: '/writing/check-a-page/',
    kind: 'Guide',
    minutes: 3,
    title: CHECKING_ARTICLE_TITLE,
    say: "Three checks anyone can run on a web tool: turn the network off, watch the requests, and read the page's own rule.",
    goesWith: cleanerCopy,
  },
  {
    href: '/writing/no-phi/',
    kind: 'Article',
    minutes: 4,
    title: ARTICLE_TITLE,
    say: 'A way to build tools that need totals from a sensitive file, and never the file itself.',
    goesWith: totalsDemo,
  },
];
---

<Base title="Writing" crumbs={[{ name: 'Writing', path: '/writing/' }]} description="Articles, guides, an essay and an analysis from ClinX: why its tools work in the browser, how they are built, ways to check each one for yourself, and what the 340B data shows.">
  <PageHead title="Writing" trail={[{ label: 'ClinX' }]}>
    <p class="lede">Why the tools here work in the browser, how they are built, how to check each one for yourself, and what the 340B data shows.</p>
  </PageHead>

  <ul class="pieces">
    {
      pieces.map((piece) => (
        <li class="card piece">
          <span class="piece-top">
            <span class="label">
              {piece.kind} · {piece.minutes} minute read
            </span>
            <Draft />
          </span>
          <span class="piece-say">
            <a class="piece-link" href={piece.href}>
              <strong>{piece.title}</strong>
            </a>
            <p>{piece.say}</p>
          </span>
          <span class="piece-foot">
            <span class="piece-go" aria-hidden="true">
              Read the {piece.kind.toLowerCase()} <Arrow />
            </span>
            <a class="piece-with" href={piece.goesWith.href}>
              <span>{piece.goesWith.kind}</span>
              {piece.goesWith.name}
            </a>
          </span>
        </li>
      ))
    }
  </ul>
  <p class="pieces-note">Each piece ends at the tool, demo or data it describes. All of the tools are on the <a href="/tools/">Tools</a> page.</p>
</Base>
