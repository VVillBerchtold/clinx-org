---
/**
 * The 340B calendar, the way in: a map (pick a state), Congress, federal agencies, what is coming
 * up, and the newest steps anywhere. Each place's whole record is on its own page (src/pages/calendar/[slug]).
 * Everything shown comes from the calendar table (src/lib/calendar.ts).
 */
import StateMap from '../../components/StateMap.astro';
import '../../styles/scorecard.css';
import '../../styles/laws.css';
import '../../styles/bills.css';
import '../../styles/calendar.css';
import Base from '../../layouts/Base.astro';
import CalendarRows from '../../components/CalendarRows.astro';
import PageHead from '../../components/PageHead.astro';
import { formatDate } from '../../lib/data';
import { BILLS_HOME, CONGRESS } from '../../lib/bills';
import { CALENDAR_HOME, byMonth, calendarFilePath, calendarMapSvg, calendarPath, calendarPlaceName, comingUp, eventsOf, getCalendar, isBillStep, isNoticeDay, isSessionDay, kindLabel, latestSteps, calendarMapCards } from '../../lib/calendar';
import { AGENCIES, NOTICES_HOME } from '../../lib/notices';

const data = getCalendar();
const steps = data.events.filter(isBillStep);
const bills = new Set(steps.map((e) => e.billId)).size;
const ahead = comingUp(data.events, data.retrieved);
const next = ahead.slice(0, 5);
const newest = latestSteps(data, 12);
const federal = eventsOf(data, CONGRESS);
const federalSteps = federal.filter((e) => !isSessionDay(e)).length;
const federalEnd = federal.find((e) => e.kind === 'session ends');
const agencyDates = eventsOf(data, AGENCIES);
const agencyAhead = comingUp(agencyDates, data.retrieved).length;
const arrow = 'M3 9h12M10 4l5 5-5 5';
---

<Base
  title="340B calendar: bill steps, hearings, session days and federal deadlines"
  crumbs={[{ name: 'Calendar', path: CALENDAR_HOME }]}
  description={`The dated steps of ${bills} bills that name the 340B program, in Congress and the state legislatures, with the days each session starts and ends and the dates of federal rules and notices. Pick a state to see its dates.`}
>
  <PageHead title="340B calendar" trail={[{ label: '340B' }]}>
    <p class="lede">
      {steps.length.toLocaleString('en-US')} dated steps of the {bills} bills that name the 340B program, in Congress and the state legislatures, with the days each session starts and ends and the dates of federal rules and notices. Pick Congress, federal agencies or a state to see its dates.
    </p>
  </PageHead>

  <div class="law-top">
    <div class="law-map">
      <StateMap
        strip
        svg={calendarMapSvg(data, 'calendar-map')}
        legend={[{ tone: 'has', label: 'Has dates on the calendar' }, { tone: 'none', label: 'No dates listed' }]}
        rest={{ note: 'Point at a state to see how many dates it has.' }}
        cards={calendarMapCards(data)}
      />
    </div>
    <div class="law-index">
      <a class="law-score bill-door" href={calendarPath(CONGRESS)}>
        <span class="label">Congress</span>
        <strong>{federalSteps} dated steps of its 340B bills</strong>
        {federalEnd && <span>The {federalEnd.what} ends on {formatDate(federalEnd.day)}.</span>}
      </a>
      {
        agencyDates.length > 0 && (
          <a class="law-score bill-door" href={calendarPath(AGENCIES)}>
            <span class="label">Federal agencies</span>
            <strong>{agencyDates.length} dates of federal rules and notices</strong>
            <span>{agencyAhead === 0 ? 'Comment deadlines and the days rules take effect.' : `${agencyAhead} still ahead: comment deadlines and the days rules take effect.`}</span>
          </a>
        )
      }
      <h2 class="label">Next on the calendar</h2>
      <ul class="kind-index cal-next">
        {
          next.map((event) => (
            <li>
              <a href={calendarPath(event.place)}>
                <strong>{calendarPlaceName(event.place)}</strong>
                <span class="kind-count">{formatDate(event.day)}</span>
                <span class="kind-what">
                  {event.kind === 'date set by a notice' ? event.what : `${kindLabel(event.kind)}: ${isSessionDay(event) || isNoticeDay(event) || event.bill === '' ? event.what : event.bill}`}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="law-index-note"><a href="#coming">Everything coming up</a></p>
    </div>
    <div class="note law-advice">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="8.5" stroke="currentColor" stroke-width="2" /><path d="M10 9v5M10 6v.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      <div>
        <p><strong>Dates can move.</strong> A legislature can change the day a session starts or ends, and a hearing can be moved or called off. Check the legislature&rsquo;s own page, linked from every date, before you plan around one.</p>
        <p>A hearing is listed when a committee posts an agenda that names one of <a href={BILLS_HOME}>the bills</a>. A federal date is listed for <a href={NOTICES_HOME}>a rule or notice</a> that is about 340B or has a part on it.</p>
      </div>
    </div>
  </div>

  <section class="section cal-section" id="coming" aria-labelledby="coming-title">
    <h2 id="coming-title">Coming up</h2>
    {
      byMonth(ahead).map((group) => (
        <div class="cal-month">
          <h3 class="label">{group.label}</h3>
          <CalendarRows events={group.events} showPlace />
        </div>
      ))
    }
  </section>

  <section class="section cal-section" id="latest" aria-labelledby="latest-title">
    <h2 id="latest-title">Latest steps</h2>
    <p>The newest steps of 340B bills anywhere, in each legislature&rsquo;s own words, and the newest federal rules and notices. Every earlier date is on the calendar of its state, of Congress or of federal agencies.</p>
    {
      byMonth(newest).map((group) => (
        <div class="cal-month">
          <h3 class="label">{group.label}</h3>
          <CalendarRows events={group.events} showPlace />
        </div>
      ))
    }
  </section>

  <section class="section law-use" aria-labelledby="use-title">
    <div>
      <h2 id="use-title">Put it in your own calendar</h2>
      <p>The dates are one open file your calendar app can open or subscribe to, and one open table you can download, check or build on. Each state&rsquo;s page has a file of its own.</p>
    </div>
    <div class="btn-row">
      <a class="btn" href={calendarFilePath()}>Calendar file (.ics) <svg viewBox="0 0 18 18" width="18" height="18" fill="none" aria-hidden="true" focusable="false"><path d={arrow} stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
      <a class="btn ghost" href="/data/#calendar">Get the data</a>
    </div>
  </section>
</Base>
