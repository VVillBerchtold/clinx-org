---
import '../../styles/pages.css';
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import Draft from '../../components/Draft.astro';
import OnPage from '../../components/OnPage.astro';
import PageHead from '../../components/PageHead.astro';
import { buildStateDrugViews, formatDate, getDataset, stateDrugCsv } from '../../lib/data';
import { getBillsRecord } from '../../lib/bills';
import { stateName, statesFileText } from '../../lib/states';
import { CITE_DATA, HC_HOME, MAKER_NAME, PREVIEW, REPOSITORIES, SITE_URL, citeLine } from '../../lib/site';
import { renderSections } from '../../lib/markdown';
import { datasetNode, healthCenterDatasetNodes } from '../../lib/structured-data';
import { fileGroups, partDays } from '../../lib/hc-hub';
import { recordsSource } from '../../lib/hc-records';

const data = getDataset();
// A file's size, the way a person reads it: the larger files are in the megabytes, and nothing is rounded to zero.
const sizeOf = (bytes: number): string => (bytes >= 1048576 ? `${(bytes / 1048576).toFixed(1)} MB` : `${Math.max(1, Math.round(bytes / 1024))} KB`);
// Files this site makes from the dataset: each state's drug rows, all filers in one file.
const sha256Hex = async (text: string): Promise<string> =>
  Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text))), (b) => b.toString(16).padStart(2, '0')).join('');
const drugFiles = await Promise.all(buildStateDrugViews(data).map(async (view) => ({ view, sha256: await sha256Hex(stateDrugCsv(view)) })));
// The repositories. Their names become links once the site is public.
const repositories = [
  { name: 'The filings dataset', href: REPOSITORIES.dataset, what: 'The data, its checks and its changelog. Corrections are reported here.' },
  { name: 'The bills, notices and calendar tables', href: REPOSITORIES.bills, what: 'Every bill and every federal rule or notice that names 340B, and their dates, with the tools that build the tables.' },
  { name: 'The registry tracker', href: REPOSITORIES.tracker, what: 'Keeps dated copies of the federal 340B registry and reports what changed.' },
  { name: 'The server for AI assistants', href: REPOSITORIES.assistants, what: 'The program behind clinx.org/mcp. It answers an assistant from the 340B tables (filings, laws, bills, notices, calendar) and from the health centers files, and only reads.' },
  { name: 'This site', href: REPOSITORIES.site, what: 'The pages you are reading, built from the dataset.' },
];
// The bills table is a second set of files, kept beside the dataset's.
const billsRecord = getBillsRecord();
const billFiles = [
  { name: 'bills.csv', id: 'bills', what: 'One row per bill in Congress or a state legislature that names the 340B program: what it is, how far it has got, its latest step, the passage that names 340B and its official links' },
  { name: '340b-bills.json', what: 'The bills table in one document, with the roles and kinds it uses' },
  { name: 'notices.csv', id: 'notices', what: 'One row per federal rule, proposed rule or notice in the Federal Register since January 2025 that names the 340B program: its title, agency and dates as the Federal Register gives them, one sentence on what it does about 340B, and its official links' },
  { name: '340b-notices.json', what: 'The notices table in one document, with the other days each document sets, in its own words' },
  { name: 'events.csv', id: 'calendar', what: 'The 340B calendar, one row per date: every dated step of a listed bill in the legislature’s own words, hearings with a listed bill on the agenda, the days each session starts and ends, and the dates of federal rules and notices' },
  { name: '340b-events.json', what: 'The calendar in one document, with what each kind of event means' },
];
// The states with a reporting law, grouped by what each state makes public: written by this site from its own registry.
const statesFileHash = await sha256Hex(statesFileText(SITE_URL));
// The health centers files, grouped by part, each with the SHA-256 of the file as this site serves it.
const hcDays = partDays();
const hcGroups = await Promise.all(fileGroups().map(async (g) => ({ ...g, files: await Promise.all(g.files.map(async (f) => ({ ...f, sha256: await sha256Hex(f.text) }))) })));
const dictionary = renderSections(data.dictionaryMarkdown);
const intro = dictionary.find((s) => s.title === '');
const fileSections = dictionary.filter((s) => s.title !== '');

const describe: Record<string, string> = {
  '340b-state-filings.json': 'Every table below in one document, with the dataset version and licence',
  'filings.csv': 'One row per filing, or per row a state printed about an entity, with the form it was made on and its kind of record',
  'entities.csv': 'One row per filer, or per entity a state names, with the type and city as printed where a state prints them',
  'line_items.csv': 'One row per printed row of a schedule, of a one-page report, or of a state report\'s tables',
  'measures.csv': 'One row per filing and measure, with its formula (a state report has none)',
  'discrepancies.csv': 'Each place where two figures of one filing or report differ',
  'vendors.csv': 'Each name as filed that has a normalized name',
  'attachments.csv': 'Pages a filer added to the form, and documents a state lists beside a report',
  '340b-state-laws.json': 'The state laws table in one document: the kinds, every law, the laws left out and why, and who publishes each official site',
  'state-laws.csv': 'One row per enacted state law that names the 340B program: what it does, who it applies to, its dates, the passage that names 340B and its official link',
  'state-laws-not-listed.csv': 'Laws that mention 340B and are left out of the table, each with the reason',
};
---

<Base
  title="ClinX open data: 340B and health centers downloads"
  description="Download the 340B state filings dataset as CSV and JSON files, read the data dictionary, and see the dataset version. Free to use under CC BY 4.0."
  crumbs={[{ name: 'Data', path: '/data/' }]}
  about={[datasetNode(data, drugFiles.map(({ view, sha256 }) => ({ name: view.csvName, path: view.csvPath, sha256 }))), ...healthCenterDatasetNodes(hcGroups, recordsSource().years)]}
>
  <PageHead title="Data" trail={[{ label: 'ClinX' }]}>
    <p class="lede">Every figure on this site, as files you can download. A 340B figure is kept as filed or printed and cites the page of the PDF it was read from. The health centers files are kept as the agencies published them.</p>
    <p class="btn-row">
      <a class="btn ghost" href="#downloads">340B data</a>
      <a class="btn ghost" href="#health-centers">Health centers data</a>
    </p>
    <OnPage
      title="Data"
      items={[
        { id: 'downloads', label: '340B downloads' },
        { id: 'health-centers', label: 'Health centers' },
        { id: 'assistants', label: 'AI assistants' },
        { id: 'version', label: 'Version' },
        { id: 'cite', label: 'How to cite' },
        { id: 'repositories', label: 'Code' },
        { id: 'data-dictionary', label: 'Data dictionary' },
      ]}
    />
  </PageHead>

  <section class="split" aria-labelledby="downloads">
    <h2 id="downloads">340B downloads</h2>
    <div class="split-body">
      <ul class="files">
        {
          data.downloads.map((name) => (
            <li>
              <div>
                <strong>{name}</strong>
                <p>{describe[name] ?? ''}</p>
                <p class="small muted">{sizeOf(data.sizes[name]!)}</p>
              </div>
              <a class="btn ghost" href={`/data/${name}`} download aria-label={`Download ${name}`}>Download</a>
              <span class="hash"><span class="visually-hidden">SHA-256: </span>{data.hashes[name]}</span>
            </li>
          ))
        }
        {
          billFiles.map((file) => (
            <li id={'id' in file ? file.id : undefined}>
              <div>
                <strong>{file.name}</strong>
                <p>{file.what}</p>
              </div>
              <a class="btn ghost" href={`/data/${file.name}`} download aria-label={`Download ${file.name}`}>Download</a>
              <span class="hash"><span class="visually-hidden">SHA-256: </span>{billsRecord.files[file.name]}</span>
            </li>
          ))
        }
        <li id="reporting-states">
          <div>
            <strong>340b-reporting-states.json</strong>
            <p>The states with a 340B reporting law, grouped by what each state makes public (each filer&rsquo;s own report, one state report naming entities, state totals only, or nothing public yet), with what is public today, whether the Scorecard holds the state&rsquo;s figures, and the official sources. Made by this site; it is the same list the <a href="/scorecard/">Scorecard</a> shows.</p>
          </div>
          <a class="btn ghost" href="/data/340b-reporting-states.json" download aria-label="Download 340b-reporting-states.json">Download</a>
          <span class="hash"><span class="visually-hidden">SHA-256: </span>{statesFileHash}</span>
        </li>
        {
          drugFiles.map(({ view, sha256 }) => (
            <li>
              <div>
                <strong>{view.csvName}</strong>
                <p>
                  One line per drug row of {view.drug.scheduleName} in the {stateName(view.state)} filings for {view.reportingYear}, all {view.views.length} filers in one file. Made by this site from line_items.csv, with the filer&rsquo;s name, the code each row is grouped by, and the name the FDA&rsquo;s drug code directory lists for that code. <a href={`${view.path}#how`}>How it is put together</a> <Draft />
                </p>
              </div>
              <a class="btn ghost" href={view.csvPath} download aria-label={`Download ${view.csvName}`}>Download</a>
              <span class="hash"><span class="visually-hidden">SHA-256: </span>{sha256}</span>
            </li>
          ))
        }
      </ul>
      <p class="small muted">Each file of the dataset shows its size under its description. The line under each file is its SHA-256, so you can confirm your copy matches.</p>
    </div>
  </section>

  <section class="split" aria-labelledby="health-centers">
    <h2 id="health-centers">Health centers</h2>
    <div class="split-body">
      <p>
        The files behind the <a href={HC_HOME}>health centers pages</a>, one group for each part. Each file holds what the agency published, in the agency's own words and marks. The line under each file is its SHA-256, so you can confirm your copy matches.
      </p>
      {
        hcGroups.map((g) => (
          <>
            <h3 id={`health-centers-${g.id}`}><a href={g.page}>{g.title}</a></h3>
            <p class="small muted">{g.day}.</p>
            <ul class="files">
              {g.files.map((f) => (
                <li>
                  <div>
                    <strong>{f.name}</strong>
                    <p>{f.what}</p>
                    <p class="small muted">{sizeOf(new TextEncoder().encode(f.text).length)}</p>
                  </div>
                  <a class="btn ghost" href={f.href} download aria-label={`Download ${f.name}`}>Download</a>
                  <span class="hash"><span class="visually-hidden">SHA-256: </span>{f.sha256}</span>
                </li>
              ))}
            </ul>
            <p class="small muted">{g.note}</p>
          </>
        ))
      }
    </div>
  </section>

  <section class="split" aria-labelledby="assistants">
    <h2 id="assistants">Ask through an AI assistant</h2>
    <div class="split-body">
      <p>
        The 340B filings, laws, bills, federal notices and calendar can also be read by an AI assistant, and so can the health centers files: the records, the funding calendar and the shortage areas. You ask a question in plain words; the assistant looks it up in the same files as the ones above and gives you the rows, each with its official link.
      </p>
      <dl class="facts">
        <dt>Address</dt>
        <dd><span class="mono">https://clinx.org/mcp</span></dd>
        <dt>What it reads</dt>
        <dd>340B: filings, state laws, bills, federal notices, the calendar. Health centers: the records, funding opportunities and their dates, shortage areas and sites</dd>
        <dt>What it changes</dt>
        <dd>Nothing. It only reads</dd>
        <dt>Cost</dt>
        <dd>Free. No key and no account</dd>
      </dl>
      <p>One page has the steps for Claude, ChatGPT and VS Code, everything an assistant can look up, questions to try and what to keep in mind.</p>
      <div class="btn-row"><a class="btn" href="/data/assistants/">Use ClinX with an AI assistant <Arrow /></a></div>
    </div>
  </section>

  <section class="split" aria-labelledby="version">
    <h2 id="version">Version</h2>
    <div class="split-body">
      <dl class="facts">
        <dt>Dataset version</dt>
        <dd>{data.version}</dd>
        <dt>Dataset commit</dt>
        <dd><span class="mono">{data.commit}</span></dd>
        <dt>Filings and reports retrieved up to</dt>
        <dd>{formatDate(data.dataDate)}</dd>
        <dt>Bills and federal notices retrieved</dt>
        <dd>{formatDate(billsRecord.retrieved)} ({billsRecord.bills} bills, {billsRecord.notices} federal notices, {billsRecord.events.toLocaleString('en-US')} calendar dates)</dd>
        <dt>Health centers files</dt>
        <dd>Records: HRSA refreshed its latest file on {hcDays.records}. Funding: files of {hcDays.funding}. Shortage areas: files of {hcDays.areas}.</dd>
        <dt>Licence</dt>
        <dd>Data: Creative Commons Attribution 4.0 (CC BY 4.0). Code: MIT.</dd>
      </dl>
    </div>
  </section>

  <section class="split" aria-labelledby="cite">
    <h2 id="cite">How to cite</h2>
    <div class="split-body">
      <p class="head-tag">
        <span>The data on this page is put together and maintained by <a href="/about/#founder-name">{MAKER_NAME}</a>, who builds ClinX. It is under Creative Commons Attribution 4.0 (CC BY 4.0): free to use and to share, with credit to the source. This line gives that credit. Put in the day you read the data.</span>
        <Draft />
      </p>
      <p class="panel">{citeLine(CITE_DATA, '/data/')}</p>
    </div>
  </section>

  <section class="split" aria-labelledby="repositories">
    <h2 id="repositories">Code</h2>
    <div class="split-body">
      <p class="head-tag"><span>Everything behind this site is open.{PREVIEW && ' The repositories open to the public when the site goes live.'}</span> <Draft /></p>
      <ul class="repos">
        {
          repositories.map((r) => (
            <li>
              <strong>{PREVIEW ? r.name : <a href={r.href}>{r.name}</a>}</strong>
              <span>{r.what}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="split" aria-labelledby="data-dictionary">
    <h2 id="data-dictionary">Data dictionary</h2>
    <div class="split-body prose doc">
      {intro && <Fragment set:html={intro.html} />}
      {
        fileSections.map((s) => (
          <>
            <h3 id={s.id}>{s.title}</h3>
            <Fragment set:html={s.html} />
          </>
        ))
      }
    </div>
  </section>
</Base>
