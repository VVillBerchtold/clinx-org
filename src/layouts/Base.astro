---
import Wordmark from '../components/Wordmark.astro';
import '../styles/tokens.css';
import '../styles/layout.css';
import displayFont from '../../node_modules/@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';
import bodyFont from '../../node_modules/@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import { CSP_FORM_META, CSP_META, NAV, OTHER_PRODUCTS, PREVIEW, SITE_NAME, SITE_URL } from '../lib/site';
import { shareCard, shareCardFor } from '../lib/share-cards';
import { formatDate, getDataset } from '../lib/data';
import { toBlock, trailNode, type Crumb, type Node } from '../lib/structured-data';

interface Props {
  title: string;
  description: string;
  /** True when the page lays out its own full-width sections. */
  bleed?: boolean;
  /** True on the one page that posts a form to this site. */
  postsForm?: boolean;
  /** True on pages a search engine should never list (not found, the form's answer pages). */
  unlisted?: boolean;
  /** The trail from the home page to this page, for search engines (see lib/structured-data.ts). */
  crumbs?: readonly Crumb[];
  /** What else this page is, for search engines: a site, a person, a dataset, an article. */
  about?: readonly Node[];
  /** The picture a shared link shows: the id of a card in scripts/brand/share-cards.json. Left out, the card of the page's section. */
  card?: string;
}

const { title, description, bleed = false, postsForm = false, unlisted = false, crumbs = [], about = [], card } = Astro.props;
const data = getDataset();
const path = Astro.url.pathname;
/** True for the menu link of the section this page is in. */
const here = (link: { href: string }): boolean => path.startsWith(link.href);
/** True for the menu group the page is in: one of its pages, or the group's own front page. */
const groupOn = (group: { items: readonly { href: string }[]; home?: string }): boolean => group.items.some(here) || (group.home !== undefined && path === group.home);
// The footer follows the main menu: the groups (340B, health centers), then the data and the tools, then the rest of the site.
const footGroups = NAV.flatMap((item) => ('items' in item ? [item] : []));
const footLinks = NAV.flatMap((item) => ('href' in item ? [item] : []));
const WORK = ['/data/', '/methods/', '/tools/', '/writing/'];
const footWork = footLinks.filter((link) => WORK.includes(link.href));
const footSite = [...footLinks.filter((link) => !WORK.includes(link.href)), { href: '/privacy/', label: 'Privacy and security' }];
const refreshFiles = import.meta.glob<{ last_refresh: string }>('../../refresh/last-refresh.json', { eager: true, import: 'default' });
const lastRefresh = Object.values(refreshFiles)[0]?.last_refresh;
const fullTitle = path === '/' ? title : `${title} | ${SITE_NAME}`;
const canonical = SITE_URL + path;
const share = card ? shareCard(card) : shareCardFor(path);
// One block of data for search engines. An unlisted page carries none.
const labels: Node[] = unlisted ? [] : [...about, ...(crumbs.length > 0 ? [trailNode(crumbs)] : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={postsForm ? CSP_FORM_META : CSP_META} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4f5fc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#080a1a" media="(prefers-color-scheme: dark)" />
    {(PREVIEW || unlisted) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="referrer" content="no-referrer" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={SITE_URL + share.path} />
    <meta property="og:image:width" content={String(share.width)} />
    <meta property="og:image:height" content={String(share.height)} />
    <meta property="og:image:alt" content={share.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {labels.length > 0 && <script is:inline type="application/ld+json" set:html={toBlock(labels)} />}
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to the content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="mark" href="/" aria-label="ClinX home"><Wordmark /></a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {
              NAV.map((item) =>
                'items' in item ? (
                  <li>
                    <details class:list={['nav-drop', { on: groupOn(item) }]}>
                      <summary>
                        {item.label}
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false"><path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      </summary>
                      <ul class="nav-panel">
                        {item.items.map((sub) => (
                          <li>
                            <a href={sub.href} aria-current={here(sub) ? 'page' : undefined}>
                              <strong>{sub.label}</strong>
                              {sub.note && <span>{sub.note}</span>}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  </li>
                ) : (
                  <li>
                    <a href={item.href} aria-current={here(item) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ),
              )
            }
          </ul>
        </nav>
        <details class="nav-menu">
          <summary>
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false"><path class="bar-a" d="M3 6h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path><path class="bar-b" d="M3 12h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
            <span>Menu</span>
          </summary>
          <nav aria-label="Main">
            <ul>
              {
                NAV.map((item) =>
                  'items' in item ? (
                    <li>
                      <details class:list={['nav-fold', { on: groupOn(item) }]} open={groupOn(item)}>
                        <summary>
                          {item.label}
                          <svg width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false"><path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </summary>
                        <ul>
                          {item.items.map((sub) => (
                            <li>
                              <a href={sub.href} aria-current={here(sub) ? 'page' : undefined}>
                                {sub.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    </li>
                  ) : (
                    <li>
                      <a href={item.href} aria-current={here(item) ? 'page' : undefined}>
                        {item.label}
                      </a>
                    </li>
                  ),
                )
              }
            </ul>
          </nav>
        </details>
      </div>
    </header>
    <main id="main" tabindex="-1">
      {
        bleed ? (
          <slot />
        ) : (
          <div class="wrap page">
            <slot />
          </div>
        )
      }
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <a class="mark" href="/" aria-label="ClinX home"><Wordmark /></a>
            <p>Open healthcare data and tools, built by Will Berchtold in Rhode Island.</p>
          </div>
          {
            footGroups.map((group) => (
              <nav class:list={{ 'foot-wide': group.items.length > 3 }} aria-label={group.label}>
                <h2>{group.label}</h2>
                <ul>
                  {group.items.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            ))
          }
          <nav aria-label="Data and tools">
            <h2>Data and tools</h2>
            <ul>
              {footWork.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="foot-pair">
            <nav aria-label="ClinX">
              <h2>ClinX</h2>
              <ul>
                {footSite.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
            <nav aria-label="Other products">
              <h2>Other products</h2>
              <ul>
                {OTHER_PRODUCTS.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </div>
        <div class="foot-base">
          <span>
            Dataset version {data.version} (<span class="mono">{data.commit.slice(0, 7)}</span>). Filings retrieved {formatDate(data.dataDate)}.
            {lastRefresh ? ` Federal registration records last checked ${formatDate(lastRefresh)}.` : ' Federal registration records: not yet checked.'}
          </span>
          <span>Code: MIT. Data: CC BY 4.0. No cookies, no trackers, no sign-in.</span>
          <a class="foot-top" href="#top">Back to top</a>
        </div>
      </div>
    </footer>
    <a class="to-top" href="#top" data-to-top hidden>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false"><path d="M7 11.5v-9M3 6l4-4 4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      <span>Back to top</span>
    </a>
    <script>
      import '../scripts/sort-table';
      import '../scripts/motion';
      import '../scripts/nav-menu';
      import '../scripts/page-nav';
    </script>
  </body>
</html>
