---
import '../styles/tokens.css';
import '../styles/layout.css';
import displayFont from '../../node_modules/@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';
import bodyFont from '../../node_modules/@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import { CSP_FORM_META, CSP_META, NAV, PREVIEW, SHARE_CARD, SITE_NAME, SITE_URL } from '../lib/site';
import { formatDate, getDataset } from '../lib/data';

interface Props {
  title: string;
  description: string;
  /** True when the page lays out its own full-width sections. */
  bleed?: boolean;
  /** True on the one page that posts a form to this site. */
  postsForm?: boolean;
  /** True on pages a search engine should never list (not found, the form's answer pages). */
  unlisted?: boolean;
}

const { title, description, bleed = false, postsForm = false, unlisted = false } = Astro.props;
const data = getDataset();
const path = Astro.url.pathname;
const refreshFiles = import.meta.glob<{ last_refresh: string }>('../../refresh/last-refresh.json', { eager: true, import: 'default' });
const lastRefresh = Object.values(refreshFiles)[0]?.last_refresh;
const fullTitle = path === '/' ? title : `${title} | ${SITE_NAME}`;
const canonical = SITE_URL + path;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={postsForm ? CSP_FORM_META : CSP_META} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4f5fc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#080a1a" media="(prefers-color-scheme: dark)" />
    {(PREVIEW || unlisted) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="referrer" content="no-referrer" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={SITE_URL + SHARE_CARD.path} />
    <meta property="og:image:width" content={String(SHARE_CARD.width)} />
    <meta property="og:image:height" content={String(SHARE_CARD.height)} />
    <meta property="og:image:alt" content={SHARE_CARD.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to the content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="mark" href="/" aria-label="ClinX home">Clin<span>X</span></a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {
              NAV.map((item) => (
                <li>
                  <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <details class="nav-menu">
          <summary>
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false"><path class="bar-a" d="M3 6h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path><path class="bar-b" d="M3 12h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
            <span>Menu</span>
          </summary>
          <nav aria-label="Main">
            <ul>
              {
                NAV.map((item) => (
                  <li>
                    <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </details>
      </div>
    </header>
    <main id="main" tabindex="-1">
      {
        bleed ? (
          <slot />
        ) : (
          <div class="wrap page">
            <slot />
          </div>
        )
      }
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <a class="mark" href="/" aria-label="ClinX home">Clin<span>X</span></a>
            <p>Open healthcare data and tools, built by Will Berchtold in Rhode Island.</p>
          </div>
          <nav aria-label="340B Scorecard">
            <h2>340B Scorecard</h2>
            <ul>
              <li><a href="/scorecard/">Scorecard</a></li>
              <li><a href="/data/">Data</a></li>
              <li><a href="/methods/">Methods</a></li>
            </ul>
          </nav>
          <nav aria-label="ClinX">
            <h2>ClinX</h2>
            <ul>
              <li><a href="/writing/">Writing</a></li>
              <li><a href="/about/">About</a></li>
              <li><a href="/products/">Products</a></li>
              <li><a href="/contact/">Contact</a></li>
              <li><a href="/privacy/">Privacy and security</a></li>
            </ul>
          </nav>
        </div>
        <div class="foot-base">
          <span>
            Dataset version {data.version} (<span class="mono">{data.commit.slice(0, 7)}</span>). Filings retrieved {formatDate(data.dataDate)}.
            {lastRefresh ? ` Federal registration records last checked ${formatDate(lastRefresh)}.` : ' Federal registration records: not yet checked.'}
          </span>
          <span>Code: MIT. Data: CC BY 4.0. No cookies, no trackers, no sign-in.</span>
          <a class="foot-top" href="#top">Back to top</a>
        </div>
      </div>
    </footer>
    <a class="to-top" href="#top" data-to-top hidden>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false"><path d="M7 11.5v-9M3 6l4-4 4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      <span>Back to top</span>
    </a>
    <script>
      import '../scripts/sort-table';
      import '../scripts/motion';
      import '../scripts/nav-menu';
      import '../scripts/page-nav';
    </script>
  </body>
</html>
